    {
      "id": "CLS-MC50CC-below-min",
      "description": "MC50CC one day before the 16th birthday: not eligible, eligible from the birthday, plan dated from it",
      "refs": ["EC-05", "F-02"],
      "input": {
        "as_of": "2026-10-23",
        "state": "DL",
        "dob": "2010-10-24",
        "vehicles": ["scooter_50cc"]
      },
      "expect": {
        "age": { "years_min": 15, "band": "under_16" },
        "classes": [
          {
            "class_code": "MC50CC",
            "eligible": false,
            "eligible_from": "2026-10-24",
            "reason_key": "elig.under_min_age",
            "content_depth": "coming"
          }
        ],
        "bundles": [
          {
            "bundle_no": 1,
            "classes": ["MC50CC"],
            "ll_from": "2026-10-24",
            "dl_test_unlock": "2026-11-23"
          }
        ],
        "blockers": { "$includes": [{ "rule_id": "BLK-UNDER-16", "due_on": "2026-10-24" }] }
      }
    },
