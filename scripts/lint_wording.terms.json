{
  "$comment": "D-19 wording bans (PROJECT_BRIEF §11, CONTENT_STYLE §8.1). English patterns are case-insensitive JS regexes; Hindi patterns are plain-text regexes (no \\b in Devanagari). Hindi equivalents need PD review (MD-004).",
  "terms": [
    {
      "id": "official",
      "lang": "en",
      "pattern": "\\bofficial(ly)?\\b",
      "reason": "D-01/D-19 impersonation risk; say 'government' or 'Sarathi'"
    },
    {
      "id": "official-hi",
      "lang": "hi",
      "pattern": "आधिकारिक",
      "reason": "D-19: 'official' in Hindi"
    },
    {
      "id": "first-ever",
      "lang": "en",
      "pattern": "\\bfirst[- ]ever\\b|\\b(India'?s|the world'?s|world'?s|the country'?s) first\\b|\\bthe first (app|platform|service|product|of its kind)\\b",
      "reason": "D-19 unprovable novelty claim ('Get my first licence' is fine)"
    },
    {
      "id": "first-ever-hi",
      "lang": "hi",
      "pattern": "भारत का पहला|भारत की पहली|देश का पहला|दुनिया का पहला|पहली बार ऐसा",
      "reason": "D-19 novelty claim in Hindi"
    },
    {
