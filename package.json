{
  "name": "margdarshak",
  "version": "0.0.0",
  "private": true,
  "description": "Margdarshak: a reference citizen front end plus an open adapter specification for India's driving-licence journey. Independent prototype, not affiliated with MoRTH/NIC/State Transport Departments.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11.9.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@margdarshak/web",
    "dev:all": "concurrently -k -n web,api -c blue,green \"pnpm --filter @margdarshak/web dev\" \"pnpm api:dev\"",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@margdarshak/web",
    "clean": "turbo run clean",
    "lint": "pnpm lint:biome && pnpm lint:facts && pnpm lint:patterns && pnpm lint:i18n",
    "lint:biome": "biome check .",
    "lint:facts": "node scripts/lint_wording.mjs && node scripts/lint_fee_literals.mjs && node scripts/lint_wording.mjs --self-test && node scripts/lint_fee_literals.mjs --self-test",
    "lint:i18n": "pnpm --filter @margdarshak/web i18n:check",
    "lint:patterns": "node scripts/lint_patterns.mjs && node scripts/lint_patterns.mjs --self-test",
    "lint:wording": "node scripts/lint_wording.mjs",
    "lint:fees": "node scripts/lint_fee_literals.mjs",
    "lint:go": "cd services/api && go vet ./...",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:go": "cd services/api && go test ./...",
    "test:e2e": "pnpm --filter @margdarshak/e2e e2e",
    "test:e2e:real": "pnpm --filter @margdarshak/e2e e2e:real",
    "test:smoke": "pnpm --filter @margdarshak/e2e e2e --grep @smoke",
    "size": "size-limit && pnpm --filter @margdarshak/web size:first-load",
    "gen:api": "pnpm --filter @margdarshak/api-client generate",
    "api:dev": "node --env-file-if-exists=.env -e \"process.env.DEV_EMBEDDED_PG??='true';process.exit(require('node:child_process').spawnSync('go',['run','./cmd/api','serve'],{cwd:'services/api',stdio:'inherit'}).status??1)\"",
    "api:seed": "node -e \"process.env.DEV_EMBEDDED_PG??='true';process.exit(require('node:child_process').spawnSync('go',['run','./cmd/seed','--profile','demo','--synthetic'],{cwd:'services/api',stdio:'inherit'}).status??1)\"",
    "api:build": "cd services/api && go build -o bin/api ./cmd/api",
    "infra:up": "docker compose -f infra/docker/compose.yaml up -d",
    "infra:down": "docker compose -f infra/docker/compose.yaml down",
    "release": "echo Releases are cut by the release-please GitHub Action on main; see docs/03-engineering/GIT_WORKFLOW.md section 6.2",
    "test:a11y": "pnpm --filter @margdarshak/e2e e2e --grep @a11y"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@size-limit/file": "14.3.0",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "lefthook": "2.2.2",
    "size-limit": "14.3.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  },
  "size-limit": [
    {
      "name": "web: global CSS (every chunked stylesheet; P2 adds games, learn and curator styles). The JS bloat ceiling is the first-load union in apps/web/scripts/first-load.mjs, which excludes lazily loaded game chunks (Turbopack hashes chunk names, so size-limit globs cannot)",
      "path": "apps/web/.next/static/chunks/*.css",
      "limit": "50 KB",
      "brotli": true
    }
  ]
}
