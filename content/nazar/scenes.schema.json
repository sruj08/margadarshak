{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/nazar/scenes.schema.json",
  "title": "Nazar scene catalogue for the AI-generated clip bank (ADR-0013)",
  "description": "content/nazar/scenes.json. Generated from packages/content/src/schema/nazar-scenes.ts by scripts/gen-nazar-schema.ts. Shot-list timing, speed-per-setting and coverage rules are enforced by Zod and src/nazar.ts, not here.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "nazar_scenes"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "promptId": {
      "type": "string",
      "const": "PRM-CLIPGEN"
    },
    "promptVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "disclosure": {
      "type": "string",
      "const": "ai_generated"
    },
    "hi_review_status": {
      "type": "string",
      "enum": ["pending_native_review", "approved"]
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "pattern": "^SCN-\\d{3}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "hazardType": {
            "type": "string",
            "enum": [
              "bus_stop_pedestrian",
              "door_opening",
              "auto_cut_in",
              "wrong_side_2w",
              "cattle_animal",
              "child_school",
              "pedestrian_median",
              "vehicle_pulling_out",
              "truck_left_turn",
              "junction_emerging",
              "overtaking_oncoming",
              "parked_vehicle_hidden",
              "cyclist",
              "surface_hazard",
              "other",
              "quiet"
            ]
          },
          "pov": {
            "type": "string",
            "enum": ["2W", "4W"]
          },
          "setting": {
            "type": "string",
            "enum": [
              "jk_hill_road",
              "jk_town",
              "kerala_town",
              "kerala_rural",
              "kerala_highway",
              "metro_arterial",
              "metro_residential",
              "small_town_market",
              "school_zone"
            ]
          },
          "roadType": {
            "type": "string",
            "enum": [
              "urban_arterial",
              "market_street",
              "residential_lane",
              "school_zone",
              "highway",
              "hill_road",
              "rural_road"
            ]
          },
          "region": {
            "type": "string",
            "pattern": "^[\\p{L}][\\p{L} .'-]{1,59}$"
          },
          "tenantTags": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2,3}$"
            }
          },
          "timeOfDay": {
            "type": "string",
            "enum": ["dawn", "day", "dusk"]
          },
          "weather": {
            "type": "string",
            "enum": ["clear", "overcast", "haze", "rain", "fog"]
          },
          "speedKmh": {
            "type": "number",
            "minimum": 10,
            "maximum": 60
          },
          "leadInS": {
            "type": "number",
            "minimum": 10
          },
          "targetDurationS": {
            "type": "integer",
            "minimum": 20,
            "maximum": 40
          },
          "scene": {
            "type": "string",
            "minLength": 20,
            "maxLength": 600
          },
          "shots": {
            "minItems": 2,
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["opening", "extension"]
                },
                "durationS": {
                  "type": "integer",
                  "minimum": 3,
                  "maximum": 10
                },
                "prompt": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 600
                },
                "hazardBegins": {
                  "type": "boolean",
                  "const": true
                },
                "cueAtS": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              },
              "required": ["kind", "durationS", "prompt"],
              "additionalProperties": false
            }
          },
          "cue": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "[ऀ-ॿ]"
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "difficulty": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "occlusion": {
            "type": "boolean"
          }
        },
        "required": [
          "sceneId",
          "revision",
          "hazardType",
          "pov",
          "setting",
          "roadType",
          "region",
          "tenantTags",
          "timeOfDay",
          "weather",
          "speedKmh",
          "leadInS",
          "targetDurationS",
          "scene",
          "shots",
          "cue",
          "difficulty",
          "occlusion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "file_kind",
    "version",
    "status",
    "licence",
    "attribution",
    "promptId",
    "promptVersion",
    "disclosure",
    "hi_review_status",
    "scenes"
  ],
  "additionalProperties": false
}
