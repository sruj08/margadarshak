{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/enums.schema.json",
  "title": "Fact enum labels (DEBRIEF_SPEC §5.2)",
  "description": "content/catalogue/enums.json. Values drill patterns expand over, with i18n labels.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "enums"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "enums": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fact_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,23}$"
          },
          "values": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]+$"
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hi": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["en", "hi"],
                  "additionalProperties": false
                },
                "pattern_drill": {
                  "type": "boolean"
                }
              },
              "required": ["value", "label"],
              "additionalProperties": false
            }
          },
          "hi_review_status": {
            "type": "string",
            "enum": ["pending_native_review", "approved"]
          }
        },
        "required": ["fact_key", "values", "hi_review_status"],
        "additionalProperties": false
      }
    }
  },
  "required": ["file_kind", "version", "status", "licence", "attribution", "enums"],
  "additionalProperties": false
}
