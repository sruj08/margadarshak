{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/skills.schema.json",
  "title": "Skill-tree nodes (GAMIFICATION_ENGINE §3.1)",
  "description": "content/catalogue/skills.json. SK-<module> for every curriculum module.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "skills"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "skills": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "skill_id": {
            "type": "string",
            "pattern": "^SK-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
          },
          "module_id": {
            "type": "string",
            "pattern": "^(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "track": {
            "type": "string",
            "enum": ["ll_syllabus", "survival", "dl_test"]
          },
          "in_skill_tree": {
            "type": "boolean"
          },
          "follows": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SK-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "skill_id": {
                  "type": "string",
                  "pattern": "^SK-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
                },
                "state": {
                  "type": "string",
                  "enum": ["learning", "mastered"]
                }
              },
              "required": ["skill_id", "state"],
              "additionalProperties": false
            }
          },
          "mastered_threshold": {
            "type": "number",
            "const": 0.8
          },
          "fading_threshold": {
            "type": "number",
            "const": 0.7
          }
        },
        "required": [
          "skill_id",
          "module_id",
          "title",
          "track",
          "in_skill_tree",
          "follows",
          "requires",
          "mastered_threshold",
          "fading_threshold"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["file_kind", "version", "status", "licence", "attribution", "skills"],
  "additionalProperties": false
}
