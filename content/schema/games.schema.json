{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/games.schema.json",
  "title": "Games as seen by the debrief (GAME_SDK §2.2)",
  "description": "content/catalogue/games.json. Default drill and how-you-did band templates per game.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "games"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "games": {
      "minItems": 10,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "game_id": {
            "type": "string",
            "enum": [
              "nazar",
              "stopping_distance",
              "blind_spot",
              "junction_scan",
              "track_twin",
              "helmet_fit",
              "golden_hour",
              "night_glare",
              "hill_road",
              "ll_sim"
            ]
          },
          "code": {
            "type": "string",
            "enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8", "G9", "G10"]
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "finding_prefix": {
            "type": "string",
            "pattern": "^[A-Z]{2,3}_$"
          },
          "module_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
            }
          },
          "skill_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SK-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
            }
          },
          "debrief_mode": {
            "type": "string",
            "enum": ["ai_or_template", "template_only"]
          },
          "build_depth_phase_1_2": {
            "type": "string",
            "enum": ["deep", "thin", "storyboard"]
          },
          "default_drill_id": {
            "type": "string",
            "pattern": "^DR-[A-Z]{2,3}-[A-Z0-9_-]+$"
          },
          "how_templates": {
            "type": "object",
            "properties": {
              "strong": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["en", "hi"],
                "additionalProperties": false
              },
              "medium": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["en", "hi"],
                "additionalProperties": false
              },
              "weak": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["en", "hi"],
                "additionalProperties": false
              }
            },
            "required": ["strong", "medium", "weak"],
            "additionalProperties": false
          },
          "review_status": {
            "type": "string",
            "enum": ["draft", "in_review", "approved"]
          },
          "hi_review_status": {
            "type": "string",
            "enum": ["pending_native_review", "approved"]
          },
          "medical_review_required": {
            "type": "boolean"
          }
        },
        "required": [
          "game_id",
          "code",
          "title",
          "finding_prefix",
          "module_ids",
          "skill_ids",
          "debrief_mode",
          "build_depth_phase_1_2",
          "default_drill_id",
          "how_templates",
          "review_status",
          "hi_review_status",
          "medical_review_required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["file_kind", "version", "status", "licence", "attribution", "games"],
  "additionalProperties": false
}
