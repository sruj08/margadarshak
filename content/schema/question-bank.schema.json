{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/question-bank.schema.json",
  "title": "LL question bank, one topic per file (CURRICULUM §2, GAME_DESIGN §11)",
  "description": "content/questions/<topic>.json. SERVER-ONLY fields: items[].key and concepts[].explanation; split with splitQuestionBank before anything reaches a client.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "question_bank"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "enum": ["LL1", "LL2", "LL3", "LL4"]
    },
    "confidence_levels": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "const": 50
        },
        {
          "type": "number",
          "const": 75
        },
        {
          "type": "number",
          "const": 100
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "answer_mode": {
      "type": "string",
      "const": "single_choice"
    },
    "concepts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string",
            "pattern": "^C-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d{3}$"
          },
          "topic": {
            "type": "string",
            "enum": ["LL1", "LL2", "LL3", "LL4"]
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "sign_family": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["MANDATORY", "CAUTIONARY", "INFORMATORY", "MARKINGS", "SIGNALS"]
              },
              {
                "type": "null"
              }
            ]
          },
          "sign_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^SIGN-(MAN|CAU|INF|MRK|SIG)-\\d{3}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
            }
          },
          "rulepack_facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^(base\\/cmvr|classes|states\\/[A-Z]{2})\\.json$"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.]+$"
                },
                "expected": {
                  "type": ["number", "string", "boolean"]
                }
              },
              "required": ["file", "id", "path", "expected"],
              "additionalProperties": false
            }
          },
          "explanation": {
            "type": "object",
            "properties": {
              "explanation_id": {
                "type": "string",
                "pattern": "^EX-C-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d{3}$"
              },
              "text": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["en", "hi"],
                "additionalProperties": false
              },
              "review_status": {
                "type": "string",
                "enum": ["draft", "in_review", "approved"]
              },
              "hi_review_status": {
                "type": "string",
                "enum": ["pending_native_review", "approved"]
              }
            },
            "required": ["explanation_id", "text", "review_status", "hi_review_status"],
            "additionalProperties": false
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^https?:\\/\\/[^\\s]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "grade": {
                  "type": "string",
                  "enum": ["OBS", "P", "P-state", "S", "MK", "unknown"]
                },
                "pin_status": {
                  "type": "string",
                  "enum": ["pinned", "to_pin", "not_applicable"]
                },
                "checked_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": ["title", "url", "grade", "pin_status", "checked_on"],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "verified": {
            "type": "boolean"
          },
          "vehicle_scope": {
            "type": "string",
            "enum": ["All", "2W", "Car"]
          },
          "available_to": {
            "anyOf": [
              {
                "type": "string",
                "const": "all"
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$"
                }
              }
            ]
          },
          "review_status": {
            "type": "string",
            "enum": ["draft", "in_review", "approved"]
          },
          "items": {
            "minItems": 3,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^C-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d{3}:v[1-9]$"
                },
                "variant": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9
                },
                "form": {
                  "type": "string",
                  "enum": [
                    "sign_to_meaning",
                    "meaning_to_sign",
                    "scenario",
                    "rule_mcq",
                    "true_false",
                    "picture_to_meaning"
                  ]
                },
                "pool": {
                  "type": "string",
                  "enum": ["practice", "mock"]
                },
                "similarity": {
                  "type": "object",
                  "properties": {
                    "level": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "basis": {
                      "type": "string",
                      "enum": ["computed", "authored"]
                    }
                  },
                  "required": ["level", "basis"],
                  "additionalProperties": false
                },
                "stem": {
                  "type": "object",
                  "properties": {
                    "en": {
                      "type": "string",
                      "minLength": 1
                    },
                    "hi": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": ["en", "hi"],
                  "additionalProperties": false
                },
                "stem_assets": {
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^SIGN-(MAN|CAU|INF|MRK|SIG)-\\d{3}$"
                      },
                      {
                        "type": "string",
                        "pattern": "^ILL-[A-Z0-9]+(-[A-Z0-9]+)*$"
                      }
                    ]
                  }
                },
                "options": {
                  "minItems": 2,
                  "maxItems": 4,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "option_id": {
                        "type": "string",
                        "enum": ["a", "b", "c", "d"]
                      },
                      "text": {
                        "type": "object",
                        "properties": {
                          "en": {
                            "type": "string",
                            "minLength": 1
                          },
                          "hi": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": ["en", "hi"],
                        "additionalProperties": false
                      },
                      "asset_id": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^SIGN-(MAN|CAU|INF|MRK|SIG)-\\d{3}$"
                          },
                          {
                            "type": "string",
                            "pattern": "^ILL-[A-Z0-9]+(-[A-Z0-9]+)*$"
                          }
                        ]
                      }
                    },
                    "required": ["option_id", "text"],
                    "additionalProperties": false
                  }
                },
                "key": {
                  "type": "object",
                  "properties": {
                    "correct_option_id": {
                      "type": "string",
                      "enum": ["a", "b", "c", "d"]
                    },
                    "option_refs": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "enum": ["a", "b", "c", "d"]
                      },
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "^SIGN-(MAN|CAU|INF|MRK|SIG)-\\d{3}$"
                      }
                    }
                  },
                  "required": ["correct_option_id"],
                  "additionalProperties": false
                }
              },
              "required": [
                "item_id",
                "variant",
                "form",
                "pool",
                "similarity",
                "stem",
                "stem_assets",
                "options",
                "key"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "concept_id",
          "topic",
          "title",
          "sign_family",
          "sign_id",
          "rule_ids",
          "rulepack_facts",
          "explanation",
          "sources",
          "confidence",
          "verified",
          "vehicle_scope",
          "available_to",
          "review_status",
          "items"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "file_kind",
    "version",
    "status",
    "licence",
    "attribution",
    "topic",
    "confidence_levels",
    "answer_mode",
    "concepts"
  ],
  "additionalProperties": false
}
