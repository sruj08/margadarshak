{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/rules.schema.json",
  "title": "Rule ID catalogue (DEBRIEF_SPEC §3)",
  "description": "content/catalogue/rules.json. ai_citable = verified && kind != 'medical'. verified:false rows never enter an AI allowlist.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "rules"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "rules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
          },
          "kind": {
            "type": "string",
            "enum": ["law", "practice", "medical", "evidence"]
          },
          "text_en": {
            "type": "string",
            "minLength": 1
          },
          "text_hi": {
            "type": "string",
            "minLength": 1
          },
          "source_title": {
            "type": "string",
            "minLength": 3
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https?:\\/\\/[^\\s]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified_on": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "reviewed_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "ai_citable": {
            "type": "boolean"
          },
          "verification_status": {
            "type": "string",
            "enum": ["review_pending", "not_verified", "draft_medical_signoff_required", "verified"]
          },
          "source_pin": {
            "type": "string",
            "enum": ["pinned", "to_pin", "not_applicable"]
          },
          "source_note": {
            "type": "string",
            "minLength": 1
          },
          "module_ids": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
            }
          },
          "hi_review_status": {
            "type": "string",
            "enum": ["pending_native_review", "approved"]
          }
        },
        "required": [
          "rule_id",
          "kind",
          "text_en",
          "text_hi",
          "source_title",
          "source_url",
          "verified_on",
          "verified",
          "reviewed_by",
          "ai_citable",
          "verification_status",
          "source_pin",
          "source_note",
          "module_ids",
          "hi_review_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["file_kind", "version", "status", "licence", "attribution", "as_of", "rules"],
  "additionalProperties": false
}
