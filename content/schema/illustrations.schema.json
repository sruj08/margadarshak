{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/illustrations.schema.json",
  "title": "Illustration catalogue (LL3 hand signals)",
  "description": "content/catalogue/illustrations.json.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "illustrations"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "illustrations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "illustration_id": {
            "type": "string",
            "pattern": "^ILL-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "subject": {
            "type": "string",
            "enum": ["hand_signal", "vehicle_lights", "scene"]
          },
          "depicts": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "view": {
            "type": "string",
            "enum": ["front", "rear", "side", "top"]
          },
          "alt": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "asset": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(signs|illustrations)\\/[A-Z0-9-]+\\.svg$"
              },
              "status": {
                "type": "string",
                "enum": ["to_draw", "drawn", "reviewed"]
              }
            },
            "required": ["path", "status"],
            "additionalProperties": false
          },
          "review_status": {
            "type": "string",
            "enum": ["draft", "in_review", "approved"]
          },
          "hi_review_status": {
            "type": "string",
            "enum": ["pending_native_review", "approved"]
          }
        },
        "required": [
          "illustration_id",
          "subject",
          "depicts",
          "view",
          "alt",
          "asset",
          "review_status",
          "hi_review_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["file_kind", "version", "status", "licence", "attribution", "illustrations"],
  "additionalProperties": false
}
