{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/module.schema.json",
  "title": "Curriculum module (CURRICULUM §2–§3)",
  "description": "content/curriculum/<module>.json for LL0–LL4, M1–M22 and DL1.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "module"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "module_id": {
      "type": "string",
      "pattern": "^(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
    },
    "track": {
      "type": "string",
      "enum": ["A_ll_syllabus", "B_road_safety", "DL_familiarisation"]
    },
    "title": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "hi": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["en", "hi"],
      "additionalProperties": false
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2"]
    },
    "priority_tenants": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "vehicle_scope": {
      "type": "string",
      "enum": ["2W", "Car", "Both", "All", "per_class"]
    },
    "deep_content_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["MCWOG", "MCWG", "LMV-NT"]
      }
    },
    "available_to": {
      "anyOf": [
        {
          "type": "string",
          "const": "all"
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        }
      ]
    },
    "phase_1_2_depth": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "pattern": "^SK-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
    },
    "game_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "nazar",
          "stopping_distance",
          "blind_spot",
          "junction_scan",
          "track_twin",
          "helmet_fit",
          "golden_hour",
          "night_glare",
          "hill_road",
          "ll_sim"
        ]
      }
    },
    "drill_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DR-[A-Z]{2,3}-[A-Z0-9_-]+$"
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
      }
    },
    "rulepack_rows": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
      }
    },
    "learning_objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LO-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d+$"
          },
          "text": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          }
        },
        "required": ["id", "text"],
        "additionalProperties": false
      }
    },
    "lessons": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^LS-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d+$"
          },
          "title": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "tenants": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "required": ["id", "title"],
        "additionalProperties": false
      }
    },
    "key_facts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KF-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d+$"
          },
          "kind": {
            "type": "string",
            "enum": ["law", "practice", "evidence", "physics", "medical", "format", "design"]
          },
          "text": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 3
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^https?:\\/\\/[^\\s]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "grade": {
                  "type": "string",
                  "enum": ["OBS", "P", "P-state", "S", "MK", "unknown"]
                },
                "pin_status": {
                  "type": "string",
                  "enum": ["pinned", "to_pin", "not_applicable"]
                },
                "checked_on": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "required": ["title", "url", "grade", "pin_status", "checked_on"],
              "additionalProperties": false
            }
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "verified": {
            "type": "boolean"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
          },
          "rulepack_row": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
          }
        },
        "required": ["id", "kind", "text", "sources", "confidence", "verified"],
        "additionalProperties": false
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MC-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d+$"
          },
          "myth": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "correction": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "rule_id": {
            "type": "string",
            "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
          }
        },
        "required": ["id", "myth", "correction"],
        "additionalProperties": false
      }
    },
    "concepts": {
      "type": "object",
      "properties": {
        "target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "authored": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d{3}$"
          }
        }
      },
      "required": ["target", "authored"],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "criterion": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1
            },
            "hi": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["en", "hi"],
          "additionalProperties": false
        },
        "readiness": {
          "type": "string",
          "enum": ["test", "road", "road_tenant", "none"]
        },
        "readiness_tenants": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          }
        },
        "item_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^C-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)-\\d{3}$"
          }
        }
      },
      "required": ["criterion", "readiness", "item_refs"],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "needs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "medical_review_required": {
          "type": "boolean"
        },
        "draft_label_until_reviewed": {
          "type": "boolean"
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewed_on": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "in_review", "approved"]
        },
        "hi_review_status": {
          "type": "string",
          "enum": ["pending_native_review", "approved"]
        }
      },
      "required": [
        "needs",
        "medical_review_required",
        "draft_label_until_reviewed",
        "reviewed_by",
        "reviewed_on",
        "status",
        "hi_review_status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "file_kind",
    "version",
    "status",
    "licence",
    "attribution",
    "module_id",
    "track",
    "title",
    "priority",
    "priority_tenants",
    "vehicle_scope",
    "deep_content_classes",
    "available_to",
    "phase_1_2_depth",
    "skill_id",
    "game_ids",
    "drill_ids",
    "rule_ids",
    "rulepack_rows",
    "learning_objectives",
    "lessons",
    "key_facts",
    "misconceptions",
    "concepts",
    "assessment",
    "review"
  ],
  "additionalProperties": false
}
