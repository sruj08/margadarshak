{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/hazard-types.schema.json",
  "title": "Nazar hazard types (NAZAR §3.3)",
  "description": "content/catalogue/hazard_types.json. Labels, skill, rules and the DR-NAZ-OCCL-<TYPE> drill per hazard type.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "hazard_types"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "hazard_types": {
      "minItems": 15,
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hazard_type": {
            "type": "string",
            "enum": [
              "bus_stop_pedestrian",
              "door_opening",
              "auto_cut_in",
              "wrong_side_2w",
              "cattle_animal",
              "child_school",
              "pedestrian_median",
              "vehicle_pulling_out",
              "truck_left_turn",
              "junction_emerging",
              "overtaking_oncoming",
              "parked_vehicle_hidden",
              "cyclist",
              "surface_hazard",
              "other"
            ]
          },
          "label": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "hi": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          },
          "definition_en": {
            "type": "string",
            "minLength": 1
          },
          "module_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
            }
          },
          "skill_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^SK-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
            }
          },
          "occlusion_drill_id": {
            "type": "string",
            "pattern": "^DR-[A-Z]{2,3}-[A-Z0-9_-]+$"
          },
          "mock_eligible": {
            "type": "boolean"
          },
          "hi_review_status": {
            "type": "string",
            "enum": ["pending_native_review", "approved"]
          }
        },
        "required": [
          "hazard_type",
          "label",
          "definition_en",
          "module_ids",
          "skill_id",
          "rule_ids",
          "occlusion_drill_id",
          "mock_eligible",
          "hi_review_status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["file_kind", "version", "status", "licence", "attribution", "hazard_types"],
  "additionalProperties": false
}
