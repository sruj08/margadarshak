{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/content/schema/findings.schema.json",
  "title": "Finding taxonomy with template texts (DEBRIEF_SPEC §2, §9)",
  "description": "content/catalogue/findings.json. Templates insert numbers only through {{fact:key}} placeholders whose keys are the finding's facts.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "file_kind": {
      "type": "string",
      "const": "findings"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"]
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "const": "Margdarshak content pack, team Chanakya (Nestiq Private Limited), 2026"
    },
    "notes": {
      "type": "string"
    },
    "findings": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Z]{2,3}_[A-Z0-9_]+$"
          },
          "game_id": {
            "type": "string",
            "enum": [
              "nazar",
              "stopping_distance",
              "blind_spot",
              "junction_scan",
              "track_twin",
              "helmet_fit",
              "golden_hour",
              "night_glare",
              "hill_road",
              "ll_sim"
            ]
          },
          "polarity": {
            "type": "string",
            "enum": ["negative", "positive"]
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,23}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "seconds",
                    "metres",
                    "centimetres",
                    "kmh",
                    "percent",
                    "times",
                    "number",
                    "ordinal",
                    "ratio",
                    "rate_per_min",
                    "enum",
                    "enum_list",
                    "boolean"
                  ]
                }
              },
              "required": ["key", "kind"],
              "additionalProperties": false
            }
          },
          "skill": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^SK-(LL[0-4]|M([1-9]|1\\d|2[0-2])|DL1)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resolution": {
                "type": "string",
                "enum": ["fixed", "per_hazard_type", "per_topic", "calibration", "none"]
              }
            },
            "required": ["id", "resolution"],
            "additionalProperties": false
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
            }
          },
          "rule_resolution": {
            "type": "string",
            "enum": ["fixed", "per_hazard_type", "per_topic", "per_sign_family", "none"]
          },
          "rulepack_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "spec_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "row_pattern": {
                  "type": "string",
                  "pattern": "^(\\{STATE\\}-)?[A-Z][A-Z0-9-]*$"
                },
                "fallback_row": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64,
                      "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["spec_ref", "row_pattern", "fallback_row"],
              "additionalProperties": false
            }
          },
          "drill_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^DR-[A-Z]{2,3}-[A-Z0-9_-]+$"
            }
          },
          "drill_pattern": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "template": {
                    "type": "string",
                    "pattern": "^DR-[A-Z]{2,3}-[A-Z0-9-]*\\{[a-z_]+\\}$"
                  },
                  "fact_key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,23}$"
                  }
                },
                "required": ["template", "fact_key"],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "template_only": {
            "type": "boolean"
          },
          "templates": {
            "type": "object",
            "properties": {
              "lacked": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["en", "hi"],
                "additionalProperties": false
              },
              "could": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["en", "hi"],
                "additionalProperties": false
              },
              "how": {
                "type": "object",
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["en", "hi"],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "review_status": {
            "type": "string",
            "enum": ["draft", "in_review", "approved"]
          },
          "hi_review_status": {
            "type": "string",
            "enum": ["pending_native_review", "approved"]
          },
          "medical_review_required": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "game_id",
          "polarity",
          "trigger",
          "severity",
          "critical",
          "facts",
          "skill",
          "rule_ids",
          "rule_resolution",
          "rulepack_refs",
          "drill_ids",
          "drill_pattern",
          "template_only",
          "templates",
          "review_status",
          "hi_review_status",
          "medical_review_required"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["file_kind", "version", "status", "licence", "attribution", "findings"],
  "additionalProperties": false
}
