      "condition": { "eq": [{ "fact": "aadhaarRelationLine" }, false] },
      "output": { "recommendPath": "non_aadhaar" },
      "text": {
        "en": "The father's/guardian's name field may come back blank and locked from Aadhaar. Options: update Aadhaar, or use the non-Aadhaar path with a document that shows the name."
