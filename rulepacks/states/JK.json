  "approvedAt": null,
  "notes": "J&K v1 (MD-030). Blockers JK-B01..JK-B10 override the base rows they name. LL test 10 questions / 6 to pass (Kashmir Life, Dec 2025, quoting the Srinagar ARTO; confidence medium, verified=false). Rs 1,050 at slot booking is in fees.json stateItems as verified=false and never added to totals. PSGA timelines unknown. Needs PD + BE sign-off and ARTO Jammu counter-visit rows (field kit 11.8).",
  "rules": [
    {
      "id": "JK-PRM-LL-TEST-MODE",
      "kind": "param",
      "overrides": "PRM-LL-TEST-MODE",
      "textKey": "rule.jk.ll.test_mode",
      "condition": true,
      "output": { "value": { "onlineAvailable": true, "where": ["home_online", "csc", "rto"] } },
      "text": {
        "en": "In J&K the LL test is online at home or at a Common Service Centre (CSC); the LL is issued the same day."
      },
      "source": {
        "title": "Kashmir Life, 03 Dec 2025 (online at home or CSC, instant LL); Sarathi J&K eKYC LL service (observed 2026-10-22)",
        "url": "https://kashmirlife.net/rto-kashmir-rolls-out-new-s-track-driving-test-for-licences-415456/"
      },
      "grade": "S",
      "checkedOn": "2026-10-22",
      "confidence": "medium",
      "verified": true,
      "approvers": ["maker:rules-agent@2026-10-23"]
    },
    {
      "id": "JK-PRM-LL-FORMAT",
      "kind": "param",
      "overrides": "PRM-LL-FORMAT",
      "textKey": "rule.jk.ll.format",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "questions": 10,
          "passCorrect": 6,
          "passPct": 60,
          "timerSeconds": null
