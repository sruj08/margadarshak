{
  "$schema": "../schema/rulepack.schema.json",
  "fileKind": "rulepack",
  "packId": "GJ",
  "name": "Gujarat overlay (partial)",
  "version": "2026.10.0",
  "extends": "IN-base@2026.10.0",
  "effectiveFrom": "2026-10-23",
  "status": "draft",
  "partial": true,
  "maker": "rules-agent",
  "checker": null,
  "approvedAt": null,
  "notes": "Partial: central CMVR rules plus researched state overrides (checked 2026-10-25). Verify at your RTO. Transport department: https://cot.gujarat.gov.in",
  "rules": [
    {
      "id": "GJ-PRM-LL-TEST-MODE",
      "kind": "param",
      "overrides": "PRM-LL-TEST-MODE",
      "textKey": "rule.gj.ll.test_mode",
      "condition": true,
      "output": {
        "value": {
          "onlineAvailable": true,
          "where": ["home_online", "rto"]
        }
      },
      "text": {
        "en": "In Gujarat the LL test can be taken online at home with Aadhaar face authentication, or at the RTO.",
        "hi": "Gujarat में लर्नर लाइसेंस टेस्ट आधार फेस ऑथेंटिकेशन के साथ घर से ऑनलाइन, या RTO पर दिया जा सकता है।"
      },
      "source": {
        "title": "Gujarat: learner's licence test mode",
        "url": "https://deshgujarat.com/2025/07/07/how-to-get-learning-licence-without-visiting-rto-in-gujarat/"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "GJ-PRM-LL-FORMAT",
      "kind": "param",
      "overrides": "PRM-LL-FORMAT",
      "textKey": "rule.gj.ll.format",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "questions": 15,
          "passCorrect": 9,
          "passPct": 60,
          "timerSeconds": null
        }
      },
      "text": {
        "en": "Gujarat LL test: {questions} questions, {passCorrect} correct to pass."
      },
      "source": {
        "title": "Gujarat: learner's licence test format",
        "url": "https://deshgujarat.com/2025/07/07/how-to-get-learning-licence-without-visiting-rto-in-gujarat/"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "GJ-PRM-LL-RETEST-GAP-DAYS",
      "kind": "param",
      "overrides": "PRM-LL-RETEST-GAP-DAYS",
      "textKey": "rule.gj.ll.retest_gap_days",
      "condition": true,
      "output": {
        "value": 1
      },
      "text": {
        "en": "In Gujarat, a failed LL test can be retaken after {value} day(s), with the LL retest fee."
      },
      "source": {
        "title": "Gujarat: learner's licence retest gap",
        "url": "https://deshgujarat.com/2025/07/07/how-to-get-learning-licence-without-visiting-rto-in-gujarat/"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "GJ-PRM-DL-TEST",
      "kind": "param",
      "overrides": "PRM-DL-TEST",
      "textKey": "rule.gj.dl.test_type",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "automated": false,
          "tracks": [
            "automated tracks at 23 RTOs (some sensors faulty, so a few RTOs test manually)"
          ]
        }
      },
      "text": {
        "en": "Gujarat uses both: automated tracks at 23 RTOs (some sensors faulty, so a few RTOs test manually)."
      },
      "source": {
