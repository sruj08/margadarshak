      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "AS-PRM-DL-TEST",
      "kind": "param",
      "overrides": "PRM-DL-TEST",
      "textKey": "rule.as.dl.test_type",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "automated": false,
          "tracks": ["inspector test at the DTO; automated tracks being built at training centres"]
        }
      },
      "text": {
        "en": "Assam driving tests are judged by an inspector: inspector test at the DTO; automated tracks being built at training centres."
      },
      "source": {
