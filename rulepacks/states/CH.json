{
  "$schema": "../schema/rulepack.schema.json",
  "fileKind": "rulepack",
  "packId": "CH",
  "name": "Chandigarh overlay (partial)",
  "version": "2026.10.0",
  "extends": "IN-base@2026.10.0",
  "effectiveFrom": "2026-10-23",
  "status": "draft",
  "partial": true,
  "maker": "rules-agent",
  "checker": null,
  "approvedAt": null,
  "notes": "Partial: central CMVR rules plus researched state overrides (checked 2026-10-25). Verify at your RTO. Transport department: https://chdtransport.gov.in",
  "rules": [
    {
      "id": "CH-PRM-LL-TEST-MODE",
      "kind": "param",
      "overrides": "PRM-LL-TEST-MODE",
      "textKey": "rule.ch.ll.test_mode",
      "condition": true,
      "output": {
        "value": {
          "onlineAvailable": true,
          "where": ["home_online", "rto"]
        }
      },
      "text": {
        "en": "In Chandigarh the LL test can be taken online at home with Aadhaar face authentication, or at the RTO.",
        "hi": "Chandigarh में लर्नर लाइसेंस टेस्ट आधार फेस ऑथेंटिकेशन के साथ घर से ऑनलाइन, या RTO पर दिया जा सकता है।"
      },
      "source": {
        "title": "Chandigarh: learner's licence test mode",
        "url": "https://timesofindia.indiatimes.com/city/chandigarh/getting-learners-licence-is-just-click-away-in-city/articleshow/102783688.cms"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "CH-PRM-LL-RETEST-GAP-DAYS",
      "kind": "param",
      "overrides": "PRM-LL-RETEST-GAP-DAYS",
      "textKey": "rule.ch.ll.retest_gap_days",
      "condition": true,
      "output": {
        "value": 15
      },
      "text": {
        "en": "In Chandigarh, a failed LL test can be retaken after {value} day(s), with the LL retest fee."
      },
      "source": {
        "title": "Chandigarh: learner's licence retest gap",
        "url": "https://timesofindia.indiatimes.com/city/chandigarh/getting-learners-licence-is-just-click-away-in-city/articleshow/102783688.cms"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "CH-PRM-DL-TEST",
      "kind": "param",
      "overrides": "PRM-DL-TEST",
      "textKey": "rule.ch.dl.test_type",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "automated": true,
          "tracks": ["automated track at the Sector 23 Traffic Park (sensors and RFID)"]
        }
      },
      "text": {
        "en": "Chandigarh driving tests run on automated tracks: automated track at the Sector 23 Traffic Park (sensors and RFID)."
      },
      "source": {
        "title": "Chandigarh: driving test type",
        "url": "https://indianexpress.com/article/cities/chandigarh/driving-tests-chandigarh-applications-failed-passed-8965270/"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "CH-NTC-STATE-NOTE",
      "kind": "notice",
      "textKey": "notice.ch.state_note",
      "condition": true,
      "output": {},
      "text": {
        "en": "About one in three applicants pass the automated track on the first try. Practise the layout."
      },
