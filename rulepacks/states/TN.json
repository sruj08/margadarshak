{
  "$schema": "../schema/rulepack.schema.json",
  "fileKind": "rulepack",
  "packId": "TN",
  "name": "Tamil Nadu overlay (partial)",
  "version": "2026.10.0",
  "extends": "IN-base@2026.10.0",
  "effectiveFrom": "2026-10-23",
  "status": "draft",
  "partial": true,
  "maker": "rules-agent",
  "checker": null,
  "approvedAt": null,
  "notes": "Partial: verify at your RTO. Contactless LL flow published by TN STA (2022); over-40 applicants need RTO approval before the LL test password; 10 automated test tracks.",
  "rules": [
    {
      "id": "TN-PRM-LL-TEST-MODE",
      "kind": "param",
      "overrides": "PRM-LL-TEST-MODE",
      "textKey": "rule.tn.ll.test_mode",
      "condition": true,
      "output": {
        "value": {
          "onlineAvailable": true,
          "where": ["home_online", "rto"]
        }
      },
      "text": {
        "en": "Tamil Nadu's contactless flow: Aadhaar e-KYC, tutorial, OTP, then the LL test online."
      },
      "source": {
        "title": "TN STA contactless LL flow (2022)",
        "url": "https://tnsta.gov.in/video/flow_LLNew2022_english.pdf"
      },
      "grade": "P-state",
      "checkedOn": "2026-10-22",
      "confidence": "high",
      "verified": true,
      "approvers": ["maker:rules-agent@2026-10-23"]
    },
    {
      "id": "TN-RT-AGE-40",
      "kind": "route",
      "overrides": "RT-AGE-40",
      "textKey": "rule.tn.route.age_40_rto_approval",
      "condition": {
        "gte": [
          {
            "ageOn": {
              "on": {
                "fact": "llDate"
              },
              "bound": "max"
            }
          },
          {
            "param": {
              "id": "PRM-FORM1A-AGE"
            }
          }
        ]
      },
      "output": {
        "llTestAtRto": true
      },
      "text": {
        "en": "In Tamil Nadu, applicants over 40 upload Form 1A and the RTO approves it before the LL test password is sent."
      },
      "source": {
        "title": "TN STA contactless LL flow (2022)",
        "url": "https://tnsta.gov.in/video/flow_LLNew2022_english.pdf"
      },
      "grade": "P-state",
      "checkedOn": "2026-10-22",
      "confidence": "high",
      "verified": true,
      "approvers": ["maker:rules-agent@2026-10-23"]
    },
    {
      "id": "TN-PRM-DL-TEST",
      "kind": "param",
      "overrides": "PRM-DL-TEST",
      "textKey": "rule.tn.dl.test_type",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "automated": false,
          "tracks": ["10 automated tracks (7 opened Feb 2026); inspector test at other RTOs"]
        }
      },
      "text": {
        "en": "Tamil Nadu uses both: 10 automated test tracks, and inspector tests at other RTOs."
      },
      "source": {
        "title": "tn.nic.in: inauguration of the automated driving test tracks (Feb 2026)",
        "url": "https://tn.nic.in/event/inauguration-of-the-adtts-by-honble-chief-minister/"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    }
  ]
}
