{
  "$schema": "../schema/rulepack.schema.json",
  "fileKind": "rulepack",
  "packId": "BR",
  "name": "Bihar overlay (partial)",
  "version": "2026.10.0",
  "extends": "IN-base@2026.10.0",
  "effectiveFrom": "2026-10-23",
  "status": "draft",
  "partial": true,
  "maker": "rules-agent",
  "checker": null,
  "approvedAt": null,
  "notes": "Partial: central CMVR rules plus researched state overrides (checked 2026-10-25). Verify at your RTO. Transport department: https://transport.bihar.gov.in",
  "rules": [
    {
      "id": "BR-PRM-LL-TEST-MODE",
      "kind": "param",
      "overrides": "PRM-LL-TEST-MODE",
      "textKey": "rule.br.ll.test_mode",
      "condition": true,
      "output": {
        "value": {
          "onlineAvailable": true,
          "where": ["home_online", "rto"]
        }
      },
      "text": {
        "en": "In Bihar the LL test can be taken online at home with Aadhaar face authentication, or at the RTO.",
        "hi": "Bihar में लर्नर लाइसेंस टेस्ट आधार फेस ऑथेंटिकेशन के साथ घर से ऑनलाइन, या RTO पर दिया जा सकता है।"
      },
      "source": {
        "title": "Bihar: learner's licence test mode",
        "url": "https://www.prabhatkhabar.com/state/bihar/muzaffarpur/transport-department-changes-driving-license-rules-applicants-can-take-test-for-learning-license-from-anywhere"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "BR-PRM-LL-RETEST-GAP-DAYS",
      "kind": "param",
      "overrides": "PRM-LL-RETEST-GAP-DAYS",
      "textKey": "rule.br.ll.retest_gap_days",
      "condition": true,
      "output": {
        "value": 7
      },
      "text": {
        "en": "In Bihar, a failed LL test can be retaken after {value} day(s), with the LL retest fee."
      },
      "source": {
        "title": "Bihar: learner's licence retest gap",
        "url": "https://www.prabhatkhabar.com/state/bihar/muzaffarpur/transport-department-changes-driving-license-rules-applicants-can-take-test-for-learning-license-from-anywhere"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "BR-PRM-DL-TEST",
      "kind": "param",
      "overrides": "PRM-DL-TEST",
      "textKey": "rule.br.dl.test_type",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "automated": false,
          "tracks": ["7 automated tracks and the IDTR at Aurangabad; manual elsewhere"]
        }
      },
      "text": {
        "en": "Bihar uses both: 7 automated tracks and the IDTR at Aurangabad; manual elsewhere."
      },
      "source": {
        "title": "Bihar: driving test type",
        "url": "https://www.marutisuzuki.com/corporate/media/press-releases/2026/february/maruti-suzuki-signs-memorandum-of-agreement-with-transport-department"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "BR-NTC-STATE-NOTE",
      "kind": "notice",
      "textKey": "notice.br.state_note",
      "condition": true,
      "output": {},
      "text": {
        "en": "If you fail the LL test, you can reapply after a week."
      },
      "refs": ["F-12"],
      "source": {
        "title": "Bihar transport department",
        "url": "https://transport.bihar.gov.in"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    }
  ]
