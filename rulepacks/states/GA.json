  "notes": "Partial: central CMVR rules plus researched state overrides (checked 2026-10-25). Verify at your RTO. Transport department: https://www.goatransport.gov.in",
  "rules": [
    {
      "id": "GA-PRM-LL-TEST-MODE",
      "kind": "param",
      "overrides": "PRM-LL-TEST-MODE",
      "textKey": "rule.ga.ll.test_mode",
      "condition": true,
      "output": {
        "value": {
          "onlineAvailable": true,
          "where": ["home_online", "rto"]
        }
      },
      "text": {
        "en": "In Goa the LL test can be taken online at home with Aadhaar face authentication, or at the RTO.",
        "hi": "Goa में लर्नर लाइसेंस टेस्ट आधार फेस ऑथेंटिकेशन के साथ घर से ऑनलाइन, या RTO पर दिया जा सकता है।"
      },
      "source": {
        "title": "Goa: learner's licence test mode",
        "url": "https://timesofindia.indiatimes.com/city/goa/learners-licence-test-only-after-clearing-facial-check/articleshow/99567251.cms"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "GA-PRM-DL-TEST",
      "kind": "param",
      "overrides": "PRM-DL-TEST",
      "textKey": "rule.ga.dl.test_type",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "automated": false,
          "tracks": ["inspector test; a camera-based track at Verna is planned"]
        }
      },
      "text": {
        "en": "Goa driving tests are judged by an inspector: inspector test; a camera-based track at Verna is planned."
      },
      "source": {
        "title": "Goa: driving test type",
        "url": "https://timesofindia.indiatimes.com/city/goa/by-next-year-automated-driving-tests-at-verna-to-eliminate-human-bias/articleshow/99422900.cms"
