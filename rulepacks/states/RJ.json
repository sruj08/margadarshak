{
  "$schema": "../schema/rulepack.schema.json",
  "fileKind": "rulepack",
  "packId": "RJ",
  "name": "Rajasthan overlay (partial)",
  "version": "2026.10.0",
  "extends": "IN-base@2026.10.0",
  "effectiveFrom": "2026-10-23",
  "status": "draft",
  "partial": true,
  "maker": "rules-agent",
  "checker": null,
  "approvedAt": null,
  "notes": "Partial: central CMVR rules plus researched state overrides (checked 2026-10-25). Verify at your RTO. Transport department: https://transport.rajasthan.gov.in",
  "rules": [
    {
      "id": "RJ-PRM-LL-TEST-MODE",
      "kind": "param",
      "overrides": "PRM-LL-TEST-MODE",
      "textKey": "rule.rj.ll.test_mode",
      "condition": true,
      "output": {
        "value": {
          "onlineAvailable": true,
          "where": ["home_online", "rto"]
        }
      },
      "text": {
        "en": "In Rajasthan the LL test can be taken online at home with Aadhaar face authentication, or at the RTO.",
        "hi": "Rajasthan में लर्नर लाइसेंस टेस्ट आधार फेस ऑथेंटिकेशन के साथ घर से ऑनलाइन, या RTO पर दिया जा सकता है।"
      },
      "source": {
        "title": "Rajasthan: learner's licence test mode",
        "url": "https://transport.rajasthan.gov.in/content/transportportal/en/transport/eservices/facelessservices.html"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "RJ-PRM-LL-FORMAT",
      "kind": "param",
      "overrides": "PRM-LL-FORMAT",
      "textKey": "rule.rj.ll.format",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "questions": 20,
          "passCorrect": 12,
          "passPct": 60,
          "timerSeconds": null
        }
      },
      "text": {
        "en": "Rajasthan LL test: {questions} questions, {passCorrect} correct to pass."
      },
      "source": {
        "title": "Rajasthan: learner's licence test format",
        "url": "https://transport.rajasthan.gov.in/content/transportportal/en/transport/eservices/facelessservices.html"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "medium",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "RJ-PRM-DL-TEST",
      "kind": "param",
      "overrides": "PRM-DL-TEST",
      "textKey": "rule.rj.dl.test_type",
      "condition": true,
      "output": {
        "value": {
          "known": true,
          "automated": false,
          "tracks": ["14 automated tracks live; all tracks to be automated"]
        }
      },
      "text": {
        "en": "Rajasthan uses both: 14 automated tracks live; all tracks to be automated."
      },
      "source": {
        "title": "Rajasthan: driving test type",
        "url": "https://timesofindia.indiatimes.com/city/jaipur/rajasthan-to-automate-all-driving-test-tracks/articleshow/131267034.cms"
      },
      "grade": "S",
      "checkedOn": "2026-10-25",
      "confidence": "high",
      "verified": false,
      "approvers": ["maker:rules-agent@2026-10-25"]
    },
    {
      "id": "RJ-NTC-STATE-NOTE",
      "kind": "notice",
      "textKey": "notice.rj.state_note",
