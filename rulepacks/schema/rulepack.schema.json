{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/rulepacks/schema/rulepack.schema.json",
  "title": "Margdarshak rule-pack files (MD-027)",
  "description": "One schema for every file in rulepacks/: the base pack and state overlays (fileKind=rulepack), fees.json (fileKind=fees) and classes.json (fileKind=classes). Every row carries provenance: source {title,url}, grade, checkedOn, confidence, verified, approvers. Rule conditions use the closed JSON expression language defined in $defs/expr (no eval). The engine additionally runs a static check (known facts, known params, depth <= 8, <= 200 rows) at load time.",
  "type": "object",
  "required": ["fileKind"],
  "oneOf": [
    { "$ref": "#/$defs/rulepackFile" },
    { "$ref": "#/$defs/feesFile" },
    { "$ref": "#/$defs/classesFile" }
  ],
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "calver": { "type": "string", "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$", "maxLength": 64 },
    "classCode": {
      "type": "string",
      "enum": [
        "MC50CC",
        "MCWOG",
        "MCWG",
        "LMV-NT",
        "LMV-TR",
        "E-RICKSHAW",
        "E-CART",
        "MGV",
        "HGMV",
        "HPMV",
        "HTV",
        "ADAPTED"
      ]
    },
    "stateCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "source": {
      "type": "object",
      "required": ["title", "url"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 3 },
        "url": { "type": "string", "pattern": "^https?://[^\\s]+$" }
      }
    },
    "grade": { "type": "string", "enum": ["OBS", "P", "P-state", "S", "MK", "unknown"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "text": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": { "en": { "type": "string" }, "hi": { "type": "string" } }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "grade", "checkedOn", "confidence", "verified", "approvers"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "grade": { "$ref": "#/$defs/grade" },
        "checkedOn": { "$ref": "#/$defs/date" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "verified": {
          "type": "boolean",
          "description": "false => the UI shows a 'verify at your RTO' chip and the row is never in an AI allowlist"
        },
        "approvers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "effectiveFrom": { "$ref": "#/$defs/date" },
        "effectiveTo": { "$ref": "#/$defs/date" }
      }
    },
    "operatorNames": {
      "enum": [
        "all",
        "any",
        "not",
        "eq",
        "ne",
        "lt",
        "lte",
        "gt",
        "gte",
        "between",
        "in",
        "has",
        "ageOn",
        "birthday",
        "daysBetween",
        "addDays",
        "addMonths",
        "fact",
        "param",
        "const"
      ]
    },
    "factNames": {
      "enum": [
        "asOf",
        "state",
        "dobPrecision",
        "dobLatest",
        "dobEarliest",
        "aadhaarAddressMatches",
        "aadhaarRelationLine",
        "aadhaarMobileLinked",
        "homeTestDevice",
        "disability",
        "hasDisability",
        "foreignLicence",
        "nri",
        "movingState",
        "holdsDl",
        "lmvDlHeldSince",
        "wantsIdp",
        "hasTestVehicle",
        "llIssuedOn",
        "requestedClasses",
        "anyTransport",
        "anyNonTransport",
        "anyForm1aAlways",
        "packPartial",
        "llDate",
        "dlTestUnlock",
        "llExpiresOn",
        "earliestLicence",
        "class.code",
        "class.minAge",
        "class.transport",
        "class.form1a"
      ]
    },
    "expr": {
      "description": "Closed expression language. A literal (boolean, integer, string, null), a list literal, or an object with exactly one operator key.",
      "anyOf": [
        { "type": ["boolean", "integer", "string", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/expr" } },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "propertyNames": { "$ref": "#/$defs/operatorNames" },
          "properties": {
            "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expr" } },
            "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/expr" } },
            "not": { "$ref": "#/$defs/expr" },
            "eq": { "$ref": "#/$defs/pair" },
            "ne": { "$ref": "#/$defs/pair" },
            "lt": { "$ref": "#/$defs/pair" },
            "lte": { "$ref": "#/$defs/pair" },
            "gt": { "$ref": "#/$defs/pair" },
            "gte": { "$ref": "#/$defs/pair" },
            "between": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": { "$ref": "#/$defs/expr" }
            },
            "in": { "$ref": "#/$defs/pair" },
            "has": { "$ref": "#/$defs/pair" },
            "ageOn": {
              "type": "object",
              "required": ["on", "bound"],
              "additionalProperties": false,
              "properties": {
                "on": { "$ref": "#/$defs/expr" },
                "bound": { "enum": ["min", "max"] }
              }
            },
            "birthday": {
              "type": "object",
              "required": ["age", "bound"],
              "additionalProperties": false,
              "properties": {
                "age": { "$ref": "#/$defs/expr" },
                "bound": { "enum": ["min", "max"] }
              }
            },
            "daysBetween": { "$ref": "#/$defs/pair" },
            "addDays": { "$ref": "#/$defs/pair" },
            "addMonths": { "$ref": "#/$defs/pair" },
            "fact": { "$ref": "#/$defs/factNames" },
            "param": {
              "type": "object",
              "required": ["id"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/ruleId" },
                "path": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
              }
            },
            "const": {}
          }
        }
      ]
    },
    "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/expr" } },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "condition",
        "output",
        "textKey",
        "source",
        "grade",
        "checkedOn",
        "confidence",
        "verified",
        "approvers"
      ],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "kind": {
          "enum": [
            "eligibility",
            "blocker",
            "warning",
            "notice",
            "route",
            "document",
            "param",
            "planner",
            "office"
          ]
        },
        "overrides": { "$ref": "#/$defs/ruleId" },
        "disabled": { "type": "boolean" },
        "appliesTo": { "type": "array", "items": { "$ref": "#/$defs/classCode" } },
        "condition": { "$ref": "#/$defs/expr" },
        "output": { "type": "object" },
        "textKey": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
        "fixKey": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
        "text": { "$ref": "#/$defs/text" },
        "refs": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(EC|F|D|P|MD)-[0-9]+$" }
        },
        "source": true,
        "grade": true,
        "checkedOn": true,
        "confidence": true,
        "verified": true,
        "approvers": true,
        "effectiveFrom": true,
        "effectiveTo": true
      },
      "allOf": [
        { "$ref": "#/$defs/provenance" },
        {
          "if": { "properties": { "kind": { "const": "param" } } },
          "then": { "properties": { "output": { "required": ["value"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "document" } } },
          "then": { "properties": { "output": { "required": ["docId", "required", "stage"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "route" } } },
          "then": { "properties": { "output": { "required": ["llTestAtRto"] } } }
        },
        {
          "if": { "properties": { "kind": { "const": "office" } } },
          "then": { "properties": { "output": { "required": ["officeId", "name", "district"] } } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["blocker", "warning", "notice"] } } },
          "then": { "required": ["refs"] }
        }
      ]
    },
    "rulepackFile": {
      "type": "object",
      "required": [
        "fileKind",
        "packId",
        "version",
        "effectiveFrom",
        "status",
        "partial",
        "maker",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "fileKind": { "const": "rulepack" },
        "packId": { "type": "string", "pattern": "^(IN-base|[A-Z]{2})$" },
        "name": { "type": "string" },
        "version": { "$ref": "#/$defs/calver" },
        "extends": { "type": "string", "pattern": "^IN-base@[0-9]{4}\\.[0-9]{2}\\.[0-9]+$" },
        "effectiveFrom": { "$ref": "#/$defs/date" },
        "status": { "enum": ["draft", "submitted", "approved", "published", "retired"] },
        "partial": { "type": "boolean" },
        "maker": { "type": "string" },
        "checker": { "type": ["string", "null"] },
        "approvedAt": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "rules": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/rule" } }
      }
    },
    "feeItem": {
      "type": "object",
      "required": [
        "id",
        "labelKey",
        "amount",
        "per",
        "stage",
        "source",
        "grade",
        "checkedOn",
        "confidence",
        "verified",
        "approvers"
      ],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/provenance" }],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "labelKey": { "type": "string" },
        "noteKey": { "type": "string" },
        "amount": { "type": "integer", "minimum": 0, "description": "integer paise" },
        "per": { "enum": ["class", "application", "attempt", "class_attempt"] },
        "stage": { "enum": ["LL", "DL", "RETEST"] },
        "smartCard": { "type": "boolean" },
        "state": { "$ref": "#/$defs/stateCode" },
        "overrides": { "$ref": "#/$defs/ruleId" },
        "includedInTotal": { "type": "boolean" },
        "source": true,
        "grade": true,
        "checkedOn": true,
        "confidence": true,
        "verified": true,
        "approvers": true,
        "effectiveFrom": true,
        "effectiveTo": true
      }
    },
    "feesFile": {
      "type": "object",
      "required": ["fileKind", "version", "currency", "unit", "items", "retest", "stateItems"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "fileKind": { "const": "fees" },
        "version": { "$ref": "#/$defs/calver" },
        "currency": { "const": "INR" },
        "unit": { "const": "paise" },
        "notes": { "type": "string" },
        "excludes": { "type": "array", "items": { "type": "string" } },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/feeItem" } },
        "retest": { "type": "array", "items": { "$ref": "#/$defs/feeItem" } },
        "stateItems": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/$defs/feeItem" }],
            "required": ["state", "includedInTotal"]
          }
        }
      }
    },
    "classRow": {
      "type": "object",
      "required": [
        "id",
        "code",
        "sarathiCode",
        "nameKey",
        "name",
        "pictures",
        "minAge",
        "guardianConsentUnder18",
        "transport",
        "form1a",
        "contentDepth",
        "prerequisites",
        "source",
        "grade",
        "checkedOn",
        "confidence",
        "verified",
        "approvers"
      ],
      "unevaluatedProperties": false,
      "allOf": [{ "$ref": "#/$defs/provenance" }],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "code": { "$ref": "#/$defs/classCode" },
        "sarathiCode": { "type": "string" },
        "nameKey": { "type": "string" },
        "name": { "$ref": "#/$defs/text" },
        "pictures": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } },
        "minAge": { "type": "integer", "minimum": 16, "maximum": 25 },
        "maxCc": { "type": ["integer", "null"] },
        "guardianConsentUnder18": { "type": "boolean" },
        "transport": { "type": "boolean" },
        "form1a": { "enum": ["always", "age40"] },
        "contentDepth": { "enum": ["deep", "thin", "coming"] },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "textKey", "verified"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/ruleId" },
              "textKey": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          }
        },
        "source": true,
        "grade": true,
        "checkedOn": true,
        "confidence": true,
        "verified": true,
        "approvers": true,
        "effectiveFrom": true,
        "effectiveTo": true
      }
    },
    "classesFile": {
      "type": "object",
      "required": ["fileKind", "version", "classes"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "fileKind": { "const": "classes" },
        "version": { "$ref": "#/$defs/calver" },
        "notes": { "type": "string" },
        "classes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/classRow" } }
      }
    }
  }
}
