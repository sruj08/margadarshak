{
  "name": "W01 · Case-clock tick (06:30 IST) → Render Workflows sweep → watchdog",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 30 6 * * *"
            }
          ]
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Every day 06:30 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "notes": "Workflow timezone = Asia/Kolkata (see settings). Render Workflows has no cron trigger, so n8n starts the sweep (D-15)."
    },
    {
      "parameters": {
        "jsCode": "// Build a signed request. Signature = HMAC-SHA256(secret, `${ts}.${body}`), hex.\n// The backend rejects |now - ts| > 300 s and replays of the same idempotency key.\nconst ts = Math.floor(Date.now() / 1000).toString();\nconst runDate = $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd');\nconst body = JSON.stringify({ run_date: runDate, tenant: 'all', source: 'n8n:W01' });\nreturn [{ json: { ts, body, idempotency_key: `case-clock:${runDate}` } }];"
      },
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Build sweep request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.ts }}.{{ $json.body }}",
        "dataPropertyName": "signature",
        "secret": "={{ $vars.MD_HMAC_SECRET }}",
        "encoding": "hex"
      },
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Sign (HMAC-SHA256)",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.MD_API_BASE }}/internal/clock/sweep",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-MD-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-MD-Signature",
              "value": "=sha256={{ $json.signature }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "API-65 start sweep (Render Workflows run)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Backend computes NOTHING here; it starts the Workflows task `case_clock_sweep` (task slug {WORKFLOW_SLUG}/case_clock_sweep) and returns { sweep_id, task_run_id }. Idempotent per run_date."
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "minutes"
      },
      "id": "a1f0c001-0000-4000-8000-000000000005",
      "name": "Wait 3 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ],
      "webhookId": "5c1d7c2e-0d0a-4b0e-9c61-0a01a0010001"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $vars.MD_API_BASE }}/internal/clock/sweep/{{ $('API-65 start sweep (Render Workflows run)').item.json.sweep_id }}/status",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $vars.MD_N8N_READ_TOKEN }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1f0c001-0000-4000-8000-000000000006",
      "name": "Get sweep status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "notes": "Returns { status: running|completed|failed, poll_count, counts: { cases_scanned, notifications_queued } }. No recipients or phone numbers: delivery happens in the backend notifier (ADR-0006)."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-status-done",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Sweep completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c-still-running",
              "leftValue": "={{ $json.status === 'running' && $runIndex < 10 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1f0c001-0000-4000-8000-000000000008",
      "name": "Still running (< 10 polls)?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        480
      ]
    },
    {
      "parameters": {
        "errorMessage": "=Case-clock sweep did not complete: status={{ $json.status }} sweep_id={{ $('API-65 start sweep (Render Workflows run)').item.json.sweep_id }}. Runbook: docs/05-ops/RUNBOOK.md#pb-08"
      },
      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Fail → W12 alert",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1760,
        560
      ]
    },
    {
      "parameters": {},
      "id": "a1f0c001-0000-4000-8000-000000000020",
      "name": "Done (backend notifier delivers)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1540,
        200
      ],
      "notes": "The sweep queued citizen notifications in the outbox; the backend notifier sends them (WhatsApp Cloud API, email, web push). n8n never sees a citizen phone number."
    }
  ],
  "connections": {
    "Every day 06:30 IST": {
      "main": [
        [
          {
            "node": "Build sweep request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build sweep request": {
      "main": [
        [
          {
            "node": "Sign (HMAC-SHA256)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign (HMAC-SHA256)": {
      "main": [
        [
          {
            "node": "API-65 start sweep (Render Workflows run)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "API-65 start sweep (Render Workflows run)": {
      "main": [
        [
          {
            "node": "Wait 3 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 3 min": {
      "main": [
        [
          {
            "node": "Get sweep status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get sweep status": {
      "main": [
        [
          {
            "node": "Sweep completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sweep completed?": {
      "main": [
        [
          {
            "node": "Done (backend notifier delivers)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Still running (< 10 polls)?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still running (< 10 polls)?": {
      "main": [
        [
          {
            "node": "Wait 3 min",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fail → W12 alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false,
    "saveExecutionProgress": false,
    "executionTimeout": 3600,
    "errorWorkflow": "REPLACE_WITH_W12_WORKFLOW_ID",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "tags": [
    {
      "name": "margdarshak"
    },
    {
      "name": "F-09 case clock"
    },
    {
      "name": "internal-ops"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": false,
    "margdarshak": {
      "workflow_id": "W01",
      "owner": "Ops lead",
      "doc": "docs/05-ops/N8N_WORKFLOWS.md#w01",
      "business_logic": "none (the sweep decides who is due; the backend notifier delivers)",
      "executions_per_month": 31,
      "required_variables": [
        "MD_API_BASE",
        "MD_HMAC_SECRET",
        "MD_N8N_READ_TOKEN"
      ]
    }
  },
  "active": false,
  "versionId": "00000000-0000-4000-8000-00000000a101"
}
