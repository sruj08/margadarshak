        ],
        [
          {
            "node": "Retryable (network/429/5xx, < 3 tries)?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retryable (network/429/5xx, < 3 tries)?": {
      "main": [
        [
          {
