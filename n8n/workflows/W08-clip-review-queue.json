      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.body.ts }}.{{ $json.body.payload }}",
        "dataPropertyName": "expected_signature",
        "secret": "={{ $vars.MD_HMAC_SECRET }}",
        "encoding": "hex"
      },
      "id": "c8a00008-0000-4000-8000-000000000002",
