      "parameters": {
        "jsCode": "// Build + sign the rater-2 task: a different person, blind to rater 1 (independent ratings, D-22).\nconst crypto = require('crypto');\n// Idempotency-Key: 16..64 chars (api/openapi.yaml); long parts collapse to a sha256 digest.\nconst key = (prefix, parts) => { const plain = [prefix, ...parts].join(':'); return plain.length <= 64 ? plain : `${prefix}:${crypto.createHash('sha256').update(parts.join('\\n')).digest('hex').slice(0, 63 - prefix.length)}`; };\n// Margdarshak-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + '.' + body)>, fresh on every attempt (replay cache).\nconst sign = (body) => { const ts = Math.floor(Date.now() / 1000).toString(); return `t=${ts},v1=${crypto.createHmac('sha256', $vars.MD_HMAC_SECRET).update(`${ts}.${body}`).digest('hex')}`; };\nconst c = $('Parse payload').first().json;\nconst r1 = $('Wait for rater 1 (≤ 48 h)').first().json.body || {};\n// ClipReviewTaskCreate again: exclude_rater_id is sent only when rater 1's pseudonym is known (never null).\nconst body = JSON.stringify({ stage: 'rater_2', resume_url: $execution.resumeUrl, n8n_execution_id: String($execution.id), ...(r1.rater_id ? { exclude_rater_id: r1.rater_id } : {}), blind_to_rater_1: true, due_in_hours: 48 });\nreturn [{ json: { clip_id: c.clip_id, body, signature: sign(body), idempotency_key: key('clip-review', [c.clip_id, `v${c.version}`, 'rater_2', String($execution.id)]) } }];"
