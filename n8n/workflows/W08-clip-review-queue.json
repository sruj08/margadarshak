    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse the signed payload only after the signature check passed. Shape checks only (D-16).\nconst p = JSON.parse($('Clip ready for review (from Workflows)').item.json.body.payload);\nconst id = String(p.clip_id ?? '');\n// clip-pipeline ids (JMU-0012) or API ids (clip_...).\nif (!/^(clip_[a-z0-9]{8,40}|[A-Z]{2,4}-\\d{4,6})$/.test(id)) throw new Error('bad clip_id');\nconst version = p.version === undefined || p.version === null ? 1 : Number(p.version);\nif (!Number.isInteger(version) || version < 1 || version > 999) throw new Error('bad version');\nreturn { json: { clip_id: id, version, proposed_windows_count: Number(p.proposed_windows_count ?? p.proposals) || 0, blur_audit_url: typeof p.blur_audit_url === 'string' ? p.blur_audit_url : null } };"
      },
      "id": "c8a00008-0000-4000-8000-000000000012",
      "name": "Parse payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 220]
    },
    {
      "parameters": {
        "jsCode": "// Build + sign the rater-1 review task (POST /internal/clips/{id}/review-tasks). Reshape only.\nconst crypto = require('crypto');\n// Idempotency-Key: 16..64 chars (api/openapi.yaml); long parts collapse to a sha256 digest.\nconst key = (prefix, parts) => { const plain = [prefix, ...parts].join(':'); return plain.length <= 64 ? plain : `${prefix}:${crypto.createHash('sha256').update(parts.join('\\n')).digest('hex').slice(0, 63 - prefix.length)}`; };\n// Margdarshak-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + '.' + body)>, fresh on every attempt (replay cache).\nconst sign = (body) => { const ts = Math.floor(Date.now() / 1000).toString(); return `t=${ts},v1=${crypto.createHmac('sha256', $vars.MD_HMAC_SECRET).update(`${ts}.${body}`).digest('hex')}`; };\nconst c = $('Parse payload').first().json;\n// Body = api/openapi.yaml ClipReviewTaskCreate (strict: stage, resume_url, n8n_execution_id, due_in_hours; the API\n// works on the clip's current version, so the version stays in the idempotency key only).\nconst body = JSON.stringify({ stage: 'rater_1', resume_url: $execution.resumeUrl, n8n_execution_id: String($execution.id), due_in_hours: 48 });\nreturn [{ json: { clip_id: c.clip_id, body, signature: sign(body), idempotency_key: key('clip-review', [c.clip_id, `v${c.version}`, 'rater_1', String($execution.id)]) } }];"
      },
