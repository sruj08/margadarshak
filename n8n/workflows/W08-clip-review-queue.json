        "jsCode": "// Build + sign POST /internal/clips/{id}/status for a rejected or timed-out review. Reshape only:\n// the status vocabulary and what happens next are decided by the backend.\nconst crypto = require('crypto');\n// Idempotency-Key: 16..64 chars (api/openapi.yaml); long parts collapse to a sha256 digest.\nconst key = (prefix, parts) => { const plain = [prefix, ...parts].join(':'); return plain.length <= 64 ? plain : `${prefix}:${crypto.createHash('sha256').update(parts.join('\\n')).digest('hex').slice(0, 63 - prefix.length)}`; };\n// Margdarshak-Signature: t=<unix>,v1=<hex HMAC-SHA256(secret, t + '.' + body)>, fresh on every attempt (replay cache).\nconst sign = (body) => { const ts = Math.floor(Date.now() / 1000).toString(); return `t=${ts},v1=${crypto.createHmac('sha256', $vars.MD_HMAC_SECRET).update(`${ts}.${body}`).digest('hex')}`; };\nconst c = $('Parse payload').first().json;\nlet r2 = false;\ntry { r2 = $('Wait for rater 2 (≤ 48 h)').isExecuted; } catch (e) { r2 = false; }\nconst src = (r2 ? $('Wait for rater 2 (≤ 48 h)') : $('Wait for rater 1 (≤ 48 h)')).first().json;\nconst stage = r2 ? 'rater_2' : 'rater_1';\nconst status = src.body?.decision === 'reject' ? 'rejected' : 'review_timeout';\n// Body = api/openapi.yaml ClipReviewOutcome (strict: status, stage, n8n_execution_id).\nconst body = JSON.stringify({ status, stage, n8n_execution_id: String($execution.id) });\nreturn [{ json: { clip_id: c.clip_id, stage, status, body, signature: sign(body), idempotency_key: key('clip-status', [c.clip_id, `v${c.version}`, status, String($execution.id)]) } }];"
