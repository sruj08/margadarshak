{
  "name": "W04 · Test-eve \"what to bring\" WhatsApp reminder (19:00 IST)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 0 19 * * *" }
          ]
        }
      },
      "id": "b4e00004-0000-4000-8000-000000000001",
      "name": "Every day 19:00 IST",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "jsCode": "const ts = Math.floor(Date.now() / 1000).toString();\nconst testDate = $now.setZone('Asia/Kolkata').plus({ days: 1 }).toFormat('yyyy-MM-dd');\nconst body = JSON.stringify({ test_date: testDate, kinds: ['ll_test', 'dl_test'], source: 'n8n:W04' });\nreturn [{ json: { ts, body, idempotency_key: `test-eve:${testDate}` } }];"
      },
      "id": "b4e00004-0000-4000-8000-000000000002",
      "name": "Build request (tomorrow, IST)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.ts }}.{{ $json.body }}",
        "dataPropertyName": "signature",
        "secret": "={{ $vars.MD_HMAC_SECRET }}",
        "encoding": "hex"
      },
      "id": "b4e00004-0000-4000-8000-000000000003",
      "name": "Sign (HMAC-SHA256)",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.MD_API_BASE }}/internal/jobs/test-eve",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-MD-Timestamp", "value": "={{ $json.ts }}" },
            { "name": "X-MD-Signature", "value": "=sha256={{ $json.signature }}" },
            { "name": "Idempotency-Key", "value": "={{ $json.idempotency_key }}" }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": { "timeout": 30000 }
      },
      "id": "b4e00004-0000-4000-8000-000000000004",
      "name": "Get tomorrow's test-takers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "notes": "Backend returns { items: [{ notification_id, to, lang, template_id, vars: [first_name, test_kind_label, office_name, slot_time_ist], ics_url, checklist_url }] }. The checklist items (RC, insurance, PUC, LL, helmet, L-plate) come from the rule pack and live behind checklist_url; ics_url is a 24 h presigned link. Opted-in WhatsApp users who are 18+ or whose guardian holds the account only."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c-has-items",
              "leftValue": "={{ ($json.items || []).length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b4e00004-0000-4000-8000-000000000005",
      "name": "Anyone tomorrow?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 300]
    },
    {
      "parameters": {},
      "id": "b4e00004-0000-4000-8000-000000000006",
      "name": "Nothing to send",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1100, 460]
    },
    {
      "parameters": { "fieldToSplitOut": "items", "options": {} },
      "id": "b4e00004-0000-4000-8000-000000000007",
      "name": "Split test-takers",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1100, 220]
    },
    {
      "parameters": { "batchSize": 40, "options": {} },
      "id": "b4e00004-0000-4000-8000-000000000008",
      "name": "Batches of 40",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1320, 220]
    },
    {
      "parameters": {
        "operation": "sendTemplate",
        "phoneNumberId": "={{ $vars.MD_WA_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $json.to }}",
        "template": "={{ $json.template_id }}|{{ $json.lang }}",
        "components": {
          "component": [
            {
              "type": "header",
              "headerParameters": {
                "parameter": [
                  { "type": "document", "documentLink": "={{ $json.ics_url }}", "filename": "driving-test.ics" }
                ]
              }
            },
            {
              "type": "body",
              "bodyParameters": {
                "parameter": "={{ $json.vars.map(v => ({ type: 'text', text: String(v) })) }}"
              }
            },
            {
              "type": "button",
              "sub_type": "url",
              "index": "0",
              "buttonParameters": {
                "parameter": [
                  { "type": "text", "text": "={{ $json.checklist_token }}" }
                ]
              }
            }
          ]
        }
      },
      "id": "b4e00004-0000-4000-8000-000000000009",
      "name": "WhatsApp md_test_eve_v1",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1540, 140],
      "credentials": {
        "whatsAppApi": { "id": "REPLACE_ON_IMPORT", "name": "Margdarshak WhatsApp Cloud (test number)" }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "notes": "Utility template (approved copy, en + hi): 'Kal aapka {{2}} hai, {{3}}, {{4}}. Saath le jaayein: list dekhiye 👇' + URL button to /test-day?c={{token}} (co-pilot F-12). No outcome words, no fees, no fear copy."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Batches of 40').item.json;\nreturn { json: { notification_id: src.notification_id, provider_message_id: $json.messages?.[0]?.id ?? null, status: 'sent' } };"
      },
      "id": "b4e00004-0000-4000-8000-00000000000a",
      "name": "Receipt: sent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 100]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Batches of 40').item.json;\nconst code = String($json.error?.code ?? $json.error?.message ?? 'unknown').slice(0, 80);\n// 131026 = message undeliverable, 131047 = re-engagement window, 131051 = unsupported type (Meta error codes; verify list at H0)\nreturn { json: { notification_id: src.notification_id, provider_message_id: null, status: 'failed', error_code: code, fallback: 'email_or_push' } };"
      },
      "id": "b4e00004-0000-4000-8000-00000000000b",
      "name": "Receipt: failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 280]
    },
    {
      "parameters": { "aggregate": "aggregateAllItemData", "destinationFieldName": "receipts", "options": {} },
      "id": "b4e00004-0000-4000-8000-00000000000c",
      "name": "Aggregate receipts",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [1980, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.MD_API_BASE }}/internal/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.MD_N8N_READ_TOKEN }}" },
            { "name": "X-MD-Event", "value": "delivery_receipts" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflow: 'W04', execution_id: $execution.id, receipts: $json.receipts, set_flag: 'copilot_ready' }) }}",
        "options": { "timeout": 20000 }
      },
      "id": "b4e00004-0000-4000-8000-00000000000d",
      "name": "API-66 ack + set co-pilot flag",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Backend sets the stage-aware home to show the test-day co-pilot (F-08/F-12) and sends email or web-push to the failed ones itself."
    }
  ],
  "connections": {
    "Every day 19:00 IST": { "main": [[{ "node": "Build request (tomorrow, IST)", "type": "main", "index": 0 }]] },
    "Build request (tomorrow, IST)": { "main": [[{ "node": "Sign (HMAC-SHA256)", "type": "main", "index": 0 }]] },
    "Sign (HMAC-SHA256)": { "main": [[{ "node": "Get tomorrow's test-takers", "type": "main", "index": 0 }]] },
    "Get tomorrow's test-takers": { "main": [[{ "node": "Anyone tomorrow?", "type": "main", "index": 0 }]] },
    "Anyone tomorrow?": {
      "main": [
        [{ "node": "Split test-takers", "type": "main", "index": 0 }],
        [{ "node": "Nothing to send", "type": "main", "index": 0 }]
      ]
    },
    "Split test-takers": { "main": [[{ "node": "Batches of 40", "type": "main", "index": 0 }]] },
    "Batches of 40": {
      "main": [
        [],
        [{ "node": "WhatsApp md_test_eve_v1", "type": "main", "index": 0 }]
      ]
    },
    "WhatsApp md_test_eve_v1": {
      "main": [
        [{ "node": "Receipt: sent", "type": "main", "index": 0 }],
        [{ "node": "Receipt: failed", "type": "main", "index": 0 }]
      ]
    },
    "Receipt: sent": { "main": [[{ "node": "Aggregate receipts", "type": "main", "index": 0 }]] },
    "Receipt: failed": { "main": [[{ "node": "Aggregate receipts", "type": "main", "index": 0 }]] },
    "Aggregate receipts": { "main": [[{ "node": "API-66 ack + set co-pilot flag", "type": "main", "index": 0 }]] },
    "API-66 ack + set co-pilot flag": { "main": [[{ "node": "Batches of 40", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all",
    "saveManualExecutions": false,
    "executionTimeout": 1800,
    "errorWorkflow": "REPLACE_WITH_W12_WORKFLOW_ID",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "tags": [
    { "name": "margdarshak" },
    { "name": "F-12 test readiness" },
    { "name": "messaging-edge" }
  ],
  "meta": {
    "templateCredsSetupCompleted": false,
    "margdarshak": {
      "workflow_id": "W04",
      "owner": "Ops lead",
      "doc": "docs/05-ops/N8N_WORKFLOWS.md#w04",
      "business_logic": "none (who has a test tomorrow and what to bring come from the backend + rule pack)",
      "executions_per_month": 31,
      "required_variables": ["MD_API_BASE", "MD_HMAC_SECRET", "MD_N8N_READ_TOKEN", "MD_WA_PHONE_NUMBER_ID"]
    }
  },
  "active": false,
  "versionId": "00000000-0000-4000-8000-00000000a104"
}
