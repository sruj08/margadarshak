{
  "name": "W09 · RTO Live Intel moderation (precheck in backend → auto-publish or WhatsApp approve/reject)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "md/intel-report",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "d9b00009-0000-4000-8000-000000000001",
      "name": "New Live Intel report (from API-28)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "3a7c2d51-6e4f-4b8a-9c1d-d9b000090001",
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_ON_IMPORT", "name": "MD inbound webhook token" }
      },
      "notes": "Signed envelope { ts, payload, sig }. payload = { report_id, office_id, fields: [slot_release_time|documents_asked|track_type|wait_time] } — structured fields only, no free text, no names (D-14). The report is stored as `pending` before this call; nothing is public yet."
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.body.ts }}.{{ $json.body.payload }}",
        "dataPropertyName": "expected_signature",
        "secret": "={{ $vars.MD_HMAC_SECRET }}",
        "encoding": "hex"
      },
      "id": "d9b00009-0000-4000-8000-000000000002",
      "name": "Compute expected HMAC",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c-sig",
              "leftValue": "={{ 'sha256=' + $json.expected_signature === $json.body.sig && Math.abs(Date.now()/1000 - Number($json.body.ts)) < 300 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d9b00009-0000-4000-8000-000000000003",
      "name": "Signature valid + fresh?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: true } }}",
        "options": { "responseCode": 202 }
      },
      "id": "d9b00009-0000-4000-8000-000000000004",
      "name": "202 Accepted",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 220]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { accepted: false, reason: 'bad_signature' } }}",
        "options": { "responseCode": 401 }
      },
      "id": "d9b00009-0000-4000-8000-000000000005",
      "name": "401 Bad signature",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 420]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = JSON.parse($('New Live Intel report (from API-28)').item.json.body.payload);\nif (!/^rep_[a-z0-9]{8,40}$/.test(p.report_id)) throw new Error('bad report_id');\nreturn { json: { report_id: p.report_id, office_id: p.office_id } };"
      },
      "id": "d9b00009-0000-4000-8000-000000000006",
      "name": "Parse payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.MD_API_BASE }}/internal/intel/{{ $json.report_id }}/precheck",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.MD_N8N_READ_TOKEN }}" }
          ]
        },
        "options": { "timeout": 20000 }
      },
      "id": "d9b00009-0000-4000-8000-000000000007",
      "name": "Backend precheck (rules decide)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Backend returns { risk: low|medium|high, auto_publish_allowed: bool, reasons: [pii_pattern|phone|upi|agent_promo|duplicate|velocity|setting_offer], corroborating_24h: n, k_threshold_met: bool, summary_for_moderator, slots_opened: bool }. The thresholds (≥ 3 corroborating in 24 h, k ≥ 5 in 30 days to SHOW a field) live in code, not here. EC-24: a 'setting'/fake-slot offer is always risk=high."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c-auto",
              "leftValue": "={{ $json.auto_publish_allowed }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d9b00009-0000-4000-8000-000000000008",
      "name": "Backend allows auto-publish?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1320, 220]
    },
    {
      "parameters": {
        "operation": "sendAndWait",
        "phoneNumberId": "={{ $vars.MD_WA_PHONE_NUMBER_ID }}",
        "recipientPhoneNumber": "={{ $vars.MD_MODERATOR_WA }}",
        "message": "=Live Intel {{ $('Parse payload').item.json.report_id }} · office {{ $('Parse payload').item.json.office_id }}\nRisk: {{ $json.risk }} ({{ ($json.reasons || []).join(', ') || 'none' }})\nCorroborating (24 h): {{ $json.corroborating_24h }}\n{{ $json.summary_for_moderator }}\nApprove only structured, factual fields. Never approve names or 'setting' offers.",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "Publish",
            "disapproveLabel": "Reject"
          }
        },
        "options": {
          "limitWaitTime": {
            "values": { "limitType": "afterTimeInterval", "resumeAmount": 12, "resumeUnit": "hours" }
          }
        }
      },
      "id": "d9b00009-0000-4000-8000-000000000009",
      "name": "Moderator: WhatsApp approve / reject (≤ 12 h)",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1540, 340],
      "webhookId": "7e1f4a22-5b3c-4d2e-8a91-d9b000090009",
      "credentials": {
        "whatsAppApi": { "id": "REPLACE_ON_IMPORT", "name": "Margdarshak WhatsApp Cloud (test number)" }
      },
      "notes": "WhatsApp send-and-wait is the approval channel that works for us; Telegram/Gmail send-and-wait has reported resume problems (n8n #13331). Moderator = a named team member (grievance-officer delegate, IT Rules 2021) who opted in. Fallback: /admin/intel page resumes an equivalent Wait node."
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normalise decision. A timeout (no reply in 12 h) is NOT an approval.\nconst approved = $json.data?.approved === true;\nconst timedOut = $json.data === undefined;\nreturn { json: { decision: approved ? 'publish' : (timedOut ? 'timeout_hold' : 'reject'), moderator: 'wa:moderator', decided_via: 'whatsapp_send_and_wait' } };"
      },
      "id": "d9b00009-0000-4000-8000-00000000000a",
      "name": "Normalise decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 340]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return { json: { decision: 'publish', moderator: 'auto', decided_via: 'backend_precheck' } };"
      },
      "id": "d9b00009-0000-4000-8000-00000000000b",
      "name": "Auto decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.MD_API_BASE }}/internal/intel/{{ $('Parse payload').item.json.report_id }}/decision",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $vars.MD_N8N_READ_TOKEN }}" },
            { "name": "Idempotency-Key", "value": "=intel-decision:{{ $('Parse payload').item.json.report_id }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ decision: $json.decision, moderator: $json.moderator, decided_via: $json.decided_via, n8n_execution_id: $execution.id }) }}",
        "options": { "timeout": 20000 }
      },
      "id": "d9b00009-0000-4000-8000-00000000000c",
      "name": "Record decision (backend publishes/rejects + audit log)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notes": "Backend applies the decision, writes E-30 AuditLog, re-checks k ≥ 5 before any field becomes visible, notifies the reporter by web push, and returns { published: bool, slots_opened: bool, office_id }."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "c-slots",
              "leftValue": "={{ $json.published === true && $json.slots_opened === true }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "d9b00009-0000-4000-8000-00000000000d",
      "name": "Published 'slots opened'?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2200, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.MD_N8N_SELF_BASE }}/webhook/md/slot-watch-alert",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-MD-Internal", "value": "={{ $vars.MD_N8N_INTERNAL_TOKEN }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ office_id: $json.office_id, report_id: $('Parse payload').item.json.report_id }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "d9b00009-0000-4000-8000-00000000000e",
      "name": "Trigger W03 slot-watch alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, 140],
      "onError": "continueRegularOutput",
      "notes": "W03 relays 'reported by N users, check Sarathi now' to watchers. We never book or scrape (D-08)."
    },
    {
      "parameters": {},
      "id": "d9b00009-0000-4000-8000-00000000000f",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [2420, 320]
    }
  ],
  "connections": {
    "New Live Intel report (from API-28)": { "main": [[{ "node": "Compute expected HMAC", "type": "main", "index": 0 }]] },
    "Compute expected HMAC": { "main": [[{ "node": "Signature valid + fresh?", "type": "main", "index": 0 }]] },
    "Signature valid + fresh?": {
