{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "gameId": {
      "type": "string",
      "enum": [
        "nazar",
        "stopping_distance",
        "blind_spot",
        "junction_scan",
        "track_twin",
        "helmet_fit",
        "golden_hour",
        "night_glare",
        "hill_road",
        "ll_sim"
      ]
    },
    "code": {
      "type": "string",
      "enum": ["G1", "G2", "G3", "G4", "G5", "G6", "G7", "G8", "G9", "G10"]
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scoringVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "telemetryVersion": {
      "type": "number",
      "const": 1
    },
    "engine": {
      "type": "string",
      "enum": ["phaser4", "video_svg", "react_dom", "react_mediapipe"]
    },
    "modules": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(M([1-9]|1\\d|2[0-2])|LL[0-4]|DL1)$"
      }
    },
    "skills": {
      "minItems": 1,
      "maxItems": 24,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SK-(M\\d{1,2}|LL\\d|DL1)$"
      }
    },
    "ruleIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^RR-[A-Z][A-Z0-9]{1,3}-\\d{3}$"
      }
    },
    "findingIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,3}_[A-Z0-9_]+$"
      }
    },
    "drillIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DR-[A-Z]{2,3}-[A-Z0-9_-]+$"
      }
    },
    "modes": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["learn", "practice", "mock", "pair"]
      }
    },
    "debriefMode": {
      "type": "string",
      "enum": ["ai_or_template", "template_only"]
    },
    "minUserBand": {
      "type": "string",
      "const": "u18"
    },
    "u18Behaviour": {
      "type": "string",
      "const": "full"
    },
    "offline": {
      "type": "boolean"
    },
    "liteMode": {
      "type": "string",
      "enum": ["full", "decision_variant", "none"]
    },
    "a11yModes": {
      "minItems": 3,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "no_audio",
          "colour_safe",
          "one_hand",
          "reduced_motion",
          "tap_only",
          "screen_reader_alt",
          "large_text",
          "safe_luminance"
        ]
      }
    },
    "assets": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string",
            "enum": ["chunk", "atlas", "clip", "model", "audio", "image"]
          }
        },
        "required": ["url", "bytes", "sha256", "kind"],
        "additionalProperties": false
      }
    },
    "budgets": {
      "type": "object",
      "properties": {
        "chunkKbGzip": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 350
        },
        "maxEvents": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 5000
        },
        "maxSessionSeconds": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1200
        }
      },
      "required": ["chunkKbGzip", "maxEvents", "maxSessionSeconds"],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "const": "Practice and familiarisation, not certification"
        },
        "hi": {
          "type": "string",
          "const": "अभ्यास और परिचय के लिए, प्रमाणन नहीं"
        }
      },
      "required": ["en", "hi"],
      "additionalProperties": false
    },
    "contentGate": {
      "type": "object",
      "properties": {
        "medicalReview": {
          "type": "boolean"
        },
        "reviewedBy": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewedOn": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "draftLabelUntilReviewed": {
          "type": "boolean"
        }
      },
      "required": ["medicalReview", "reviewedBy", "reviewedOn", "draftLabelUntilReviewed"],
      "additionalProperties": false
    }
  },
  "required": [
    "gameId",
    "code",
    "version",
    "scoringVersion",
    "telemetryVersion",
    "engine",
    "modules",
    "skills",
    "ruleIds",
    "findingIds",
    "drillIds",
    "modes",
    "debriefMode",
    "minUserBand",
    "u18Behaviour",
    "offline",
    "liteMode",
    "a11yModes",
    "assets",
    "budgets",
    "label",
    "contentGate"
  ],
  "additionalProperties": false,
  "$id": "https://margdarshak.example/schemas/game-core/GameManifest.json",
  "title": "GameManifest"
}
