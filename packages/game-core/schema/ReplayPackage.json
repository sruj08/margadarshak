{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "telemetryVersion": {
      "type": "number",
      "const": 1
    },
    "encoding": {
      "type": "string",
      "enum": ["mdr1", "mdr1+gzip"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "inputs": {
      "type": "string",
      "maxLength": 524288,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eventCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    }
  },
  "required": ["telemetryVersion", "encoding", "seed", "inputs", "digest", "eventCount"],
  "additionalProperties": false,
  "$id": "https://margdarshak.example/schemas/game-core/ReplayPackage.json",
  "title": "ReplayPackage"
}
