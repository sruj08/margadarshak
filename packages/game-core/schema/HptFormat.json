{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^HPT-[A-Z]{2}$"
    },
    "clips": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "marks_per_clip": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "max_hazards_per_clip": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "pass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_marks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": ["announced", "in_force", "on_hold", "stayed", "postponed", "withdrawn"]
    },
    "source_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_on": {
      "anyOf": [
        {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "rule_id",
    "clips",
    "marks_per_clip",
    "max_hazards_per_clip",
    "pass",
    "total_marks",
    "status",
    "source_url",
    "verified_on",
    "confidence"
  ],
  "$id": "https://margdarshak.example/schemas/game-core/HptFormat.json",
  "title": "HptFormat"
}
