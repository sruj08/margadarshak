        "onlyB": 0,
        "finalHazards": [
          { "hazardId": "h1", "hazardType": "bus_stop_pedestrian", "aMs": 12167, "bMs": 16367 },
          { "hazardId": "h2", "hazardType": "wrong_side_2w", "aMs": 29900, "bMs": 34300 }
