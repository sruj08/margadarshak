{
  "description": "Golden vectors for computeAgreement (packages/clip-pipeline/src/agreement.ts). The Go job step clip.agreement must produce the same accepted flag, reasons, deltas and final windows. Options: DEFAULT_AGREEMENT (onset <= 500 ms, end <= 1000 ms, IoU >= 0.3, <= 2 hazards, 30 fps frame snapping).",
  "cases": [
    {
      "name": "perfect match",
      "raterA": [{ "hazardType": "bus_stop_pedestrian", "aMs": 12000, "bMs": 16500 }],
      "raterB": [{ "hazardType": "bus_stop_pedestrian", "aMs": 12000, "bMs": 16500 }],
      "expected": {
        "accepted": true,
        "reasons": [],
        "pairs": [{ "deltaOnsetMs": 0, "deltaEndMs": 0 }],
        "onlyA": 0,
        "onlyB": 0,
        "finalHazards": [
          { "hazardId": "h1", "hazardType": "bus_stop_pedestrian", "aMs": 12000, "bMs": 16500 }
        ]
      }
    },
    {
      "name": "onset delta exactly 0.5 s is accepted; mean snapped to the nearest frame",
      "raterA": [{ "hazardType": "bus_stop_pedestrian", "aMs": 12000, "bMs": 16500 }],
      "raterB": [{ "hazardType": "bus_stop_pedestrian", "aMs": 12500, "bMs": 17000 }],
      "expected": {
        "accepted": true,
        "reasons": [],
        "pairs": [{ "deltaOnsetMs": 500, "deltaEndMs": 500 }],
        "onlyA": 0,
        "onlyB": 0,
        "finalHazards": [
          { "hazardId": "h1", "hazardType": "bus_stop_pedestrian", "aMs": 12267, "bMs": 16767 }
        ]
      }
    },
    {
      "name": "onset delta 0.6 s needs a third rater",
      "raterA": [{ "hazardType": "bus_stop_pedestrian", "aMs": 12000, "bMs": 16500 }],
      "raterB": [{ "hazardType": "bus_stop_pedestrian", "aMs": 12600, "bMs": 16500 }],
      "expected": {
        "accepted": false,
        "reasons": ["onset_delta"],
        "pairs": [{ "deltaOnsetMs": 600, "deltaEndMs": 0 }],
        "onlyA": 0,
        "onlyB": 0,
        "finalHazards": []
      }
    },
    {
      "name": "end delta 1.1 s needs a third rater",
      "raterA": [{ "hazardType": "auto_cut_in", "aMs": 5000, "bMs": 9000 }],
