        { "hazardType": "bus_stop_pedestrian", "aMs": 12000, "bMs": 16500 },
        { "hazardType": "auto_cut_in", "aMs": 25000, "bMs": 28000 }
      ],
      "raterB": [{ "hazardType": "bus_stop_pedestrian", "aMs": 12100, "bMs": 16400 }],
      "expected": {
        "accepted": false,
