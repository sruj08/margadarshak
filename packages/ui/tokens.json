    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 12, "unit": "px" } },
    "4": { "$value": { "value": 16, "unit": "px" }, "$description": "mobile gutter" },
    "5": { "$value": { "value": 20, "unit": "px" }, "$description": "card padding" },
    "6": { "$value": { "value": 24, "unit": "px" } },
    "8": { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" }, "$description": "section gap" },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } }
  },

  "radius": {
    "$type": "dimension",
    "$description": "1:1 with UX4G radius none/xs/sm/md/lg/xl/2xl/full.",
    "none": { "$value": { "value": 0, "unit": "px" } },
    "xs": { "$value": { "value": 2, "unit": "px" } },
    "sm": { "$value": { "value": 4, "unit": "px" } },
    "md": { "$value": { "value": 8, "unit": "px" }, "$description": "inputs" },
    "lg": { "$value": { "value": 12, "unit": "px" }, "$description": "chips, small cards" },
    "xl": { "$value": { "value": 16, "unit": "px" }, "$description": "cards (Sarvam --radius-card)" },
    "2xl": { "$value": { "value": 24, "unit": "px" }, "$description": "sheets, hero cards" },
    "full": { "$value": { "value": 999, "unit": "px" }, "$description": "buttons, pills, orb" }
  },

  "size": {
    "$type": "dimension",
    "target-min": { "$value": { "value": 48, "unit": "px" }, "$description": "every interactive target (exceeds WCAG 2.5.8's 24px)" },
    "button-primary": { "$value": { "value": 56, "unit": "px" } },
    "input": { "$value": { "value": 56, "unit": "px" } },
    "icon-sm": { "$value": { "value": 20, "unit": "px" } },
    "icon-md": { "$value": { "value": 24, "unit": "px" } },
    "icon-lg": { "$value": { "value": 32, "unit": "px" } },
    "pictogram": { "$value": { "value": 64, "unit": "px" } },
    "orb": { "$value": { "value": 72, "unit": "px" } },
    "tabbar": { "$value": { "value": 64, "unit": "px" } },
    "measure-reading": { "$value": { "value": 680, "unit": "px" } },
    "measure-dashboard": { "$value": { "value": 1200, "unit": "px" } },
    "focus-ring": { "$value": { "value": 3, "unit": "px" } },
    "focus-offset": { "$value": { "value": 2, "unit": "px" } }
  },

  "breakpoint": {
    "$type": "dimension",
    "sm": { "$value": { "value": 360, "unit": "px" }, "$description": "4 columns" },
    "md": { "$value": { "value": 600, "unit": "px" }, "$description": "8 columns" },
    "lg": { "$value": { "value": 1024, "unit": "px" }, "$description": "12 columns" },
    "xl": { "$value": { "value": 1440, "unit": "px" } }
  },

  "shadow": {
    "$type": "shadow",
    "e1": { "$value": [
      { "color": "#21215A0D", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } },
      { "color": "#21219129", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 14, "unit": "px" }, "blur": { "value": 36, "unit": "px" }, "spread": { "value": -12, "unit": "px" } }
    ], "$description": "hover / pressed card" },
    "e2": { "$value": [
      { "color": "#0000000F", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 0, "unit": "px" }, "blur": { "value": 40, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
    ], "$description": "sheets, popovers (plus 1px hairline ring in CSS)" },
    "e3": { "$value": [
      { "color": "#21219133", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 28, "unit": "px" }, "blur": { "value": 64, "unit": "px" }, "spread": { "value": -28, "unit": "px" } }
    ], "$description": "modal, score reveal" }
  },

  "duration": {
    "$type": "duration",
    "instant": { "$value": { "value": 80, "unit": "ms" } },
    "fast": { "$value": { "value": 160, "unit": "ms" } },
    "base": { "$value": { "value": 240, "unit": "ms" } },
    "slow": { "$value": { "value": 400, "unit": "ms" } },
    "reveal": { "$value": { "value": 700, "unit": "ms" } },
    "reward-max": { "$value": { "value": 1200, "unit": "ms" }, "$description": "ceiling for any celebration" }
  },

  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1], "$description": "UI state changes (Sarvam/Vakyam --ease-cw)" },
    "out-expo": { "$value": [0.16, 1, 0.3, 1], "$description": "entrances, sheets (Sarvam's most used)" },
    "reveal": { "$value": [0.25, 1, 0.5, 1], "$description": "text/section reveal (Vakyam)" },
    "nav": { "$value": [0.22, 1, 0.36, 1], "$description": "route transitions (Vakyam)" },
    "exit": { "$value": [0.4, 0, 1, 1], "$description": "leaving elements" },
    "spring-reward": { "$value": [0.34, 1.56, 0.64, 1], "$description": "GAME REWARDS ONLY" }
  },

  "opacity": {
    "$type": "number",
    "disabled": { "$value": 0.5 },
    "glow": { "$value": 0.4 },
    "glow-dark": { "$value": 0.18 }
  },

  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "sticky": { "$value": 10 },
    "tabbar": { "$value": 20 },
    "orb": { "$value": 30 },
    "sheet": { "$value": 40 },
    "modal": { "$value": 50 },
    "toast": { "$value": 60 },
    "skip-link": { "$value": 100 }
  }
}
