{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://margdarshak.example/schema/clip.schema.json",
  "title": "Nazar clip metadata (clip.json, E-20)",
  "description": "Generated from packages/clip-pipeline/src/schema.ts by scripts/gen-schema.ts. Do not edit. Cross-field rules (windows inside the clip, unique IDs, quiet segments clear of hazards, origin rules for ai_generated clips, publish invariants) are enforced by the Zod schema and status.ts, not here.",
  "type": "object",
  "properties": {
    "clipId": {
      "type": "string",
      "pattern": "^[A-Z]{2,4}-\\d{4,6}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "raw",
        "transcoded",
        "blurred",
        "audited",
        "proposed",
        "rated",
        "adjudication",
        "published",
        "retired"
      ]
    },
    "tenantTags": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,3}$"
      }
    },
    "city": {
      "type": "string",
      "pattern": "^[\\p{L}][\\p{L} .'-]{1,59}$"
    },
    "roadType": {
      "type": "string",
      "enum": [
        "urban_arterial",
        "market_street",
        "residential_lane",
        "school_zone",
        "highway",
        "hill_road",
        "rural_road"
      ]
    },
    "timeOfDay": {
      "type": "string",
      "enum": ["dawn", "day", "dusk", "night"]
    },
    "weather": {
      "type": "string",
      "enum": ["clear", "overcast", "haze", "rain", "fog"]
    },
    "pov": {
      "type": "string",
      "enum": ["2W", "4W"]
    },
    "capturedMonth": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "speedKmhEst": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 150
        },
        {
          "type": "null"
        }
      ]
    },
    "speedSource": {
      "type": "string",
      "enum": ["rider_log", "speedometer", "passenger_estimate", "not_logged", "scene_spec"]
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 900000
    },
    "hazards": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hazardId": {
            "type": "string",
            "pattern": "^h[1-9]\\d?$"
          },
          "hazardType": {
            "type": "string",
            "enum": [
              "bus_stop_pedestrian",
              "door_opening",
              "auto_cut_in",
              "wrong_side_2w",
              "cattle_animal",
              "child_school",
              "pedestrian_median",
              "vehicle_pulling_out",
              "truck_left_turn",
              "junction_emerging",
              "overtaking_oncoming",
              "parked_vehicle_hidden",
              "cyclist",
              "surface_hazard",
              "other"
            ]
          },
          "window": {
            "type": "object",
            "properties": {
              "aMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "bMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["aMs", "bMs"],
            "additionalProperties": false
          },
          "raterCount": {
            "type": "integer",
            "minimum": 2,
            "maximum": 3
          },
          "deltaOnsetMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "deltaEndMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "adjudicated": {
            "type": "boolean"
          },
          "occlusion": {
            "type": "boolean"
          },
          "cueText": {
            "type": "object",
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              }
            },
            "required": ["en", "hi"],
            "additionalProperties": false
          }
        },
        "required": [
          "hazardId",
          "hazardType",
          "window",
          "raterCount",
          "deltaOnsetMs",
          "deltaEndMs",
          "adjudicated",
          "occlusion",
          "cueText"
        ],
        "additionalProperties": false
      }
    },
    "quietSegments": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "toMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["fromMs", "toMs"],
        "additionalProperties": false
      }
    },
    "difficulty": {
      "type": "object",
      "properties": {
        "curator": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "empirical": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            {
              "type": "null"
            }
          ]
        },
        "irt": {
          "type": ["number", "null"]
        },
        "nTakers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["curator", "empirical", "irt", "nTakers"],
      "additionalProperties": false
    },
    "modules": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^M\\d{1,2}$"
      }
    },
    "licence": {
      "type": "string",
      "const": "CC-BY-4.0"
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "blurAudit": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "auditor": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*-[a-z0-9]{1,16}$"
            },
            "framesChecked": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "misses": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "auditedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": ["auditor", "framesChecked", "misses", "auditedAt"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "res": {
            "type": "string",
            "enum": ["360p", "480p"]
          },
          "bytes": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": ["res", "bytes", "sha256"],
        "additionalProperties": false
      }
    },
    "origin": {
      "default": "filmed",
      "type": "string",
      "enum": ["filmed", "ai_generated"]
    },
    "generation": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,63}$"
        },
        "sceneId": {
          "type": "string",
          "pattern": "^SCN-\\d{3}$"
        },
        "promptVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "seedOrBatchId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "generatedAt": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 41000
        },
        "extensions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "synthId": {
          "type": "boolean",
          "const": true
        },
        "disclosure": {
          "type": "string",
          "const": "ai_generated"
        }
      },
      "required": [
        "model",
        "sceneId",
        "promptVersion",
        "generatedAt",
        "durationMs",
        "extensions",
        "synthId",
        "disclosure"
      ],
      "additionalProperties": false
    },
    "syntheticReview": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*-[a-z0-9]{1,16}$"
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "noRealPersonLikeness": {
          "type": "boolean",
          "const": true
        },
        "noReadablePlates": {
          "type": "boolean",
          "const": true
        },
        "noRealBrands": {
          "type": "boolean",
          "const": true
        },
        "noCollisionOrInjury": {
          "type": "boolean",
          "const": true
        },
        "hazardVisible": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "reviewer",
        "checkedAt",
        "noRealPersonLikeness",
        "noReadablePlates",
        "noRealBrands",
        "noCollisionOrInjury",
        "hazardVisible"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "clipId",
    "version",
    "status",
    "tenantTags",
    "city",
    "roadType",
    "timeOfDay",
    "weather",
    "pov",
    "capturedMonth",
    "speedKmhEst",
    "speedSource",
    "durationMs",
    "hazards",
    "quietSegments",
    "difficulty",
    "modules",
    "licence",
    "attribution",
    "blurAudit",
    "media"
  ],
  "additionalProperties": false
}
