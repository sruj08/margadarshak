# =====================================================================================
# Margdarshak — environment variables (example)
# Copy to `.env` for local development:  cp .env.example .env   (PowerShell: Copy-Item)
# NEVER commit real values. `.env*` is git-ignored except this file. No secrets in chat.
# Values here are local-only placeholders or safe defaults. "change-me" values MUST be
# replaced (generate with: uv run python -c "import secrets;print(secrets.token_urlsafe(48))").
# Read by: services/api + services/workflows (pydantic-settings), apps/* (Next.js, only
# NEXT_PUBLIC_* reach the browser), services/score-verifier, infra/docker/compose.dev.yml.
# Docs: docs/03-engineering/ENVIRONMENT_SETUP.md, BACKEND.md, FRONTEND.md
# =====================================================================================


# -------------------------------------------------------------------------------------
# 1. Application
# -------------------------------------------------------------------------------------
# local | test | staging | field | production
#   field      = any environment that touches real (consented) participants; forces paid-tier checks
#   production = state adoption (Phase 3+)
APP_ENV=local
# Shown in /v1/health and logs; CI sets the git SHA
APP_VERSION=0.1.0-local
# IANA timezone for calendar-day maths (LL day 30, expiry). Storage is always UTC.
APP_TIMEZONE=Asia/Kolkata
# Text of the non-affiliation footer is in i18n files; this toggles the first-launch sheet (never off in field/production)
SHOW_FIRST_LAUNCH_DISCLAIMER=true
# Comma-separated origins allowed by CORS on the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


# -------------------------------------------------------------------------------------
# 2. Tenancy (E-31) — tenant = State/UT
# -------------------------------------------------------------------------------------
# Default tenant when the host does not decide one (J&K for the hackathon; P-01 Kabir is in Jammu)
DEFAULT_TENANT=JK
# Tenants enabled in this deployment (rule packs must exist under rulepacks/<code>/)
ENABLED_TENANTS=JK,DL,KL
# Host → tenant mapping for white-label deployments (host=tenant;host=tenant). Empty locally.
TENANT_HOST_MAP=


# -------------------------------------------------------------------------------------
# 3. Citizen web app (apps/web) and console (apps/console) — Next.js
#    NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets here.
# -------------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Margdarshak
# Public API base URL used by the browser
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Voice WebSocket base (API-40)
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# Public origin of the citizen app (share cards, QR links, manifest)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Console origin (magic-link redirects for console users)
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001
# Default locale: hi | en  (doi = reviewed Dogri strings, falls back to hi)
NEXT_PUBLIC_DEFAULT_LOCALE=hi
# Public base URL of blurred clips / static media (R2 public bucket or CDN). Local: MinIO or /public
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:9000/margdarshak-media
# Origin the clip media is served from (CSP media-src/img-src/connect-src and the service-worker
# clip cache). With the API's mock object store it is the API origin (/mock/media/).
NEXT_PUBLIC_MEDIA_HOST=http://localhost:8000
# Sentry DSN for the browser (optional; PII scrubbing is always on)
NEXT_PUBLIC_SENTRY_DSN=
# Web push public key (VAPID); private key is in section 9
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Register the service worker in dev (normally false: avoids stale caches while developing)
NEXT_PUBLIC_SW_IN_DEV=false
# Server-side only: API URL over Render's private network for React Server Component fetches
API_INTERNAL_URL=http://localhost:8000


# -------------------------------------------------------------------------------------
# 4. API server (services/api)
# -------------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Uvicorn workers in production = 2 × vCPU (see PERFORMANCE.md §6.4); 1 locally with --reload
API_WORKERS=1
# Log level: DEBUG (local only) | INFO | WARNING
LOG_LEVEL=INFO
# Expose /docs and /openapi.json (true only in local/test/staging)
API_DOCS_ENABLED=true
# Enables /internal/test/* helpers (FrozenClock control for e2e). Compiled out unless APP_ENV=test.
TEST_HOOKS_ENABLED=false


# -------------------------------------------------------------------------------------
# 5. Database — PostgreSQL 16
# -------------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://margdarshak:margdarshak@localhost:5432/margdarshak
# Pool per API process
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
# Statement timeout (ms) applied per session
DB_STATEMENT_TIMEOUT_MS=5000
# Role used by platform jobs that bypass row-level security (audited). Leave empty locally.
DATABASE_URL_PLATFORM=


# -------------------------------------------------------------------------------------
# 6. Key Value / Redis — sessions, rate limits, compiled rule-pack cache, HMAC nonce cache
# -------------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Default rate-limit bucket multiplier (1.0 = limits in BACKEND.md §15); raise only for load tests
RATE_LIMIT_MULTIPLIER=1.0


# -------------------------------------------------------------------------------------
# 7. Auth and sessions
# -------------------------------------------------------------------------------------
# Signs device-session tokens, magic links and voice WS tickets
SESSION_SECRET=change-me
# Sliding lifetime of an anonymous device session (days)
DEVICE_SESSION_TTL_DAYS=180
# Helper-mode idle auto-logout (minutes) — EC-14 shared phone / cyber café
HELPER_IDLE_LOGOUT_MINUTES=10
# Magic-link email sign-in
MAGIC_LINK_TTL_MINUTES=15
# Google OIDC (optional sign-in)
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Phase 3+: DigiLocker OAuth (PKCE) after NeGD requester onboarding — leave empty in the hackathon
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
# Phase 3+: Jan Parichay SSO for console users via adapter
JANPARICHAY_CLIENT_ID=
JANPARICHAY_CLIENT_SECRET=


# -------------------------------------------------------------------------------------
# 8. Security — HMAC between services, field encryption
# -------------------------------------------------------------------------------------
# n8n ⇄ API webhooks (API-65, API-66 and outbound "what to send" calls). Same value in n8n credentials.
HMAC_N8N_SECRET=change-me
# Allowed clock skew for signed requests (seconds)
HMAC_MAX_SKEW_SECONDS=300
# API ⇄ score verifier
VERIFIER_SHARED_SECRET=change-me
# AES-256-GCM key (base64, 32 bytes) for E-14 contacts (phone/email). Generate:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
FIELD_ENCRYPTION_KEY=change-me
# Key id written next to ciphertext (rotate by adding a new id; keep old keys for decrypt)
FIELD_ENCRYPTION_KEY_ID=k1
# HMAC key used to derive non-reversible refs for logs (principal_ref, contact_ref)
LOG_PSEUDONYM_KEY=change-me


# -------------------------------------------------------------------------------------
# 9. Government and platform adapters (F-56) — mock | deeplink | real
#    "real" adapters exist only after a state/NIC/NeGD grants access (Phase 3+).
# -------------------------------------------------------------------------------------
# Sarathi: mock (demo statuses, "simulated" chip) | deeplink (Mode A: copy-pack + link) | real (Mode B)
ADAPTER_SARATHI=deeplink
SARATHI_DEEPLINK_BASE_URL=https://sarathi.parivahan.gov.in/
ADAPTER_DIGILOCKER=mock
# Aadhaar OFFLINE verification only (QR/XML). Never eKYC, never OTP, never the number (D-07).
ADAPTER_AADHAAR_OFFLINE=mock
ADAPTER_BHASHINI=mock
BHASHINI_API_KEY=
BHASHINI_USER_ID=
# Payments are always redirects to Sarathi / the state gateway; Margdarshak never takes money
ADAPTER_PAYMENT=redirect
ADAPTER_SLOTS=mock
# Notifications: n8n (WhatsApp/email via n8n) | console (log only, local) — SMS only after TRAI DLT (D-16)
ADAPTER_NOTIFY=console
# Object storage: s3 (R2/MinIO) | local
ADAPTER_STORAGE=s3


# -------------------------------------------------------------------------------------
# 10. Notifications
# -------------------------------------------------------------------------------------
# n8n webhook base (local container: http://localhost:5678/webhook; cloud: https://<instance>.app.n8n.cloud/webhook)
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
# Optional: n8n Cloud W15 Sarathi Portal Outage Watchdog webhook URL for 1-click judge simulation on /apply/handoff
NEXT_PUBLIC_N8N_SARATHI_WATCHDOG_URL=
# Web push (VAPID) private key and contact
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.invalid
# Transactional email sender (used by magic links; via SMTP or n8n)
EMAIL_FROM=Margdarshak <no-reply@example.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# SMS stays disabled until TRAI DLT sender + templates are registered (D-16)
SMS_ENABLED=false


# -------------------------------------------------------------------------------------
# 11. AI — Gemini via Google ADK (models in env, PROJECT_BRIEF §10), Sarvam for Dogri
# -------------------------------------------------------------------------------------
# template (no AI; always available) | adk (Gemini via ADK graph) — EC-29 falls back to template automatically
NARRATOR=template
GEMINI_API_KEY=
# Model used by the Go ADK agents (scam explainer API-43, debrief API-36, tutor API-41, decoder API-42).
# Put the key in a local .env (gitignored); `pnpm api:dev` loads it. Empty key = templates only.
GEMINI_MODEL=gemini-3.8-flash
# Must be true before any real (non-synthetic) user data reaches Gemini: paid tier only (D-13, R-13).
# The API refuses AI in APP_ENV=field|production unless this is true.
GEMINI_BILLING_CONFIRMED=false
# Model IDs (pin at H0 against research/ps1-deep/04-ai-adk-gemini.md; ADK support for 3.8 Live is unverified)
DEBRIEF_MODEL=gemini-3.1-flash-lite
COACH_MODEL=gemini-3.1-flash-lite
TUTOR_MODEL=gemini-3.1-flash-lite
DECODER_MODEL=gemini-3.8-flash
SIGNSNAP_MODEL=gemini-3.8-flash
CLIP_PROPOSER_MODEL=gemini-3.8-flash
# Inline debrief budget before the template is kept (ms)
DEBRIEF_TIMEOUT_MS=6000
# Circuit breaker: open when fallback rate exceeds this share over 5 minutes
AI_FALLBACK_BREAKER_THRESHOLD=0.20
# Prompt text retention in the debriefs table (days)
AI_PROMPT_RETENTION_DAYS=7
# Sarvam (Saaras v3 STT for doi-IN / ks-IN; Bulbul v3 TTS hi-IN) — disclosed processor
SARVAM_API_KEY=
ASR_DOGRI_PROVIDER=sarvam


# -------------------------------------------------------------------------------------
# 12. Voice guide (F-30, API-40)
# -------------------------------------------------------------------------------------
VOICE_ENABLED=false
VOICE_MODEL=gemini-3.8-live
VOICE_MODEL_FALLBACK=gemini-2.5-flash-native-audio-preview-12-2025
# Free-plan monthly cap per user (minutes)
VOICE_MONTHLY_MINUTES_CAP=10
# WS ticket lifetime (seconds)
VOICE_TICKET_TTL_SECONDS=60


# -------------------------------------------------------------------------------------
# 13. Durable jobs — Render Workflows (Python SDK `render-sdk`)
# -------------------------------------------------------------------------------------
# inline (in-process; local/tests/degraded mode) | render (Render Workflows)
JOB_RUNNER=inline
# Render API key for starting task runs (server-side only). Never a production key on a laptop.
RENDER_API_KEY=
# Workflow service slug; tasks are addressed as "<WORKFLOW_SLUG>/<task_name>"
WORKFLOW_SLUG=margdarshak-workflows
# true = talk to the local task server started by `render workflows dev` (:8120)
RENDER_USE_LOCAL_DEV=false
# Needed only for Render object storage / Key Value SDK features (not used in Phase 1–2)
RENDER_WORKSPACE_ID=
RENDER_REGION=singapore
# Clock sweep batch size and parallelism (BACKEND.md §7.2)
CLOCK_SWEEP_BATCH_SIZE=500
CLOCK_SWEEP_MAX_PARALLEL=8


# -------------------------------------------------------------------------------------
# 14. Score verifier (services/score-verifier, Node 22, private network)
# -------------------------------------------------------------------------------------
SCORE_VERIFIER_URL=http://localhost:8081
SCORE_VERIFIER_PORT=8081
SCORE_VERIFIER_TIMEOUT_MS=2000
# Go API (P2): the HMAC secret it signs compute calls with (alias VERIFIER_SHARED_SECRET above;
# dev default dev-only-verifier-secret), the address and the per-call budget.
SCORE_VERIFIER_SHARED_SECRET=
SCORE_VERIFIER_HOSTPORT=localhost:8081
SCORE_VERIFIER_TIMEOUT=2s
# Verifier: 512 KB replays plus inline clip documents exceed the 256 KB default body limit.
VERIFIER_BODY_LIMIT_BYTES=1048576
# Verifier: server-side content built by `pnpm --filter @margdarshak/score-verifier build:content`
VERIFIER_CONTENT_DIR=services/score-verifier/content
# Go API (P2): curriculum + game-items index (default: the repo's content/ folder)
CONTENT_DIR=
# Client vs server score tolerance (percentage points) before replay_mismatch is flagged
SCORE_REPLAY_TOLERANCE_PCT=1.0
# Below this trust a session counts for practice only (no share card, no percentiles)
SCORE_MIN_TRUST=0.6


# -------------------------------------------------------------------------------------
# 15. Object storage — Cloudflare R2 in the hackathon (S3-compatible), MinIO locally
#     Production: an Indian S3-compatible store (D-17)
# -------------------------------------------------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-local-only
# Public bucket: blurred, published clips + manifest only
S3_BUCKET_MEDIA=margdarshak-media
# Private bucket: pipeline intermediates, user exports (signed URLs, short TTL)
S3_BUCKET_PRIVATE=margdarshak-private
SIGNED_URL_TTL_SECONDS=900
# Go API (P2, decision D5): mock = files under MOCK_MEDIA_DIR served by the API at /mock/media/
# with signed expiring URLs; r2 = Cloudflare R2 (stdlib SigV4). R2_* are required with r2.
OBJECT_STORE=mock
MOCK_MEDIA_DIR=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_CLIPS=margdarshak-clips-public
R2_BUCKET_INGEST=margdarshak-clips-ingest
# CDN origin of the public clip bucket; empty = presigned URLs
MEDIA_PUBLIC_BASE_URL=
MEDIA_URL_TTL=2h
# n8n webhook paths the API posts to: W08 clip review queue, W14 field-test capture
N8N_CLIP_READY_PATH=/webhook/md/clip-ready
N8N_STUDY_WEBHOOK_PATH=/webhook/md/session-end
# Sent as X-MD-Resume-Token when a saved rating resumes a W08 Wait node
N8N_RESUME_AUTH_TOKEN=
# dev/test only: raise the anonymous device-session limit (10 per hour per IP) for e2e runs
DEV_DEVICE_SESSION_RATE_LIMIT=


# -------------------------------------------------------------------------------------
# 16. Observability
# -------------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# OpenTelemetry (OTLP/HTTP). Empty = tracing to console in local, disabled elsewhere.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=margdarshak-api
# Production (Phase 3+): CERT-In 180-day log retention in India; NTP to NIC/NPL — infra settings, not env


# -------------------------------------------------------------------------------------
# 17. Feature flags (defaults; tenants can override in tenant config)
# -------------------------------------------------------------------------------------
FLAG_AI_COACH=true
FLAG_VOICE=false
FLAG_SCHOOL_PORTAL=true
FLAG_RTO_LIVE_INTEL=true
FLAG_SIGN_SNAP=false
FLAG_SARATHI_REAL=false
# Minimum k for any aggregate shown in Live Intel / State console (k-anonymity)
K_ANONYMITY_MIN=5


# -------------------------------------------------------------------------------------
# 18. Field study (F-57) — only after the confirmed hackathon start (R-14); 18+ only
# -------------------------------------------------------------------------------------
FIELD_STUDY_ENABLED=false
# Comma-separated study codes accepted by /lab/[studyCode]
FIELD_STUDY_CODES=


# -------------------------------------------------------------------------------------
# 19. n8n container (infra/docker/compose.dev.yml) — local only
# -------------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me
# Base URL n8n uses to call the API from inside Docker
N8N_API_BASE_URL=http://host.docker.internal:8000


# -------------------------------------------------------------------------------------
# 20. Tooling — tests and load
# -------------------------------------------------------------------------------------
# Playwright base URL for e2e
E2E_BASE_URL=http://localhost:3000
# k6 target (never production without the Ops lead's approval)
LOAD_TARGET_URL=http://localhost:8000
